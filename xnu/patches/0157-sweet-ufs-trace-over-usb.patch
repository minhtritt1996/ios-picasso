+/*
+ * The filesystem cannot persist the ring on this port (writes never complete), so
+ * anything worth reading is kept in RAM and pulled over the USB control channel
+ * with `ufslog`. Same text also goes to the ring, where it still helps a live read.
+ */
+static char ufs_trace_buf[4096];
+static uint32_t ufs_trace_pos;
+
+static void
+ufs_trace_put(const char *line, int n)
+{
+	for (int i = 0; i < n; i++) {
+		ufs_trace_buf[ufs_trace_pos % sizeof(ufs_trace_buf)] = line[i];
+		ufs_trace_pos++;
+	}
+}
