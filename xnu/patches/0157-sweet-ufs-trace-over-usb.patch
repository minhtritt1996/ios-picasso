 }
 
+/* Copy up to max bytes of the trace buffer, starting `from` bytes back from the
+ * write position. Returns how many bytes were written to out. */
+uint32_t
+sweet_ufs_trace_copy(uint32_t from, char *out, uint32_t max)
+{
+	uint32_t have = MIN(ufs_trace_pos, (uint32_t)sizeof(ufs_trace_buf));
+
+	if (from > have) {
+		from = have;
+	}
+	uint32_t n = MIN(max, have - from);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = ufs_trace_buf[(ufs_trace_pos - have + from + i) % sizeof(ufs_trace_buf)];
+	}
+	return n;
+}
