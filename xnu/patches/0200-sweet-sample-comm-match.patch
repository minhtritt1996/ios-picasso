 }
 
+static int
+sweet_sample_name_proc(proc_t p, __unused void *arg)
+{
+	static int n;
+	if (n++ < 60) {
+		printf("SMP proc %s comm %s pid %d stat %d\n", p->p_name[0] ? p->p_name : "?",
+		    p->p_comm[0] ? p->p_comm : "?", proc_pid(p), p->p_stat);
+	}
+	return PROC_RETURNED;
+}
+
+int
+sweet_sample_dump_names(void)
+{
+	proc_iterate(PROC_ALLPROCLIST, sweet_sample_name_proc, NULL, NULL, NULL);
+	return 0;
+}
