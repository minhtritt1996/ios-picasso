+/* Queue one control frame to the sender. Called from the event thread. */
+static void
+ud_ctl_reply(const uint8_t *dst, const char *text, uint32_t len)
+{
+	mbuf_t m = NULL;
+	uint32_t flen = ETHER_HDR_LEN + len;
+
+	if (dst == NULL || len == 0 || flen > UD_FRAME_MAX) {
+		return;
+	}
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    !(mbuf_flags(m) & MBUF_EXT) || mbuf_maxlen(m) < flen) {
+		if (m != NULL) {
+			mbuf_freem(m);
 		}
-		size_t sent = 0;
-		sock_send(so, &msg, 0, &sent);
+		return;
 	}
+	uint8_t *f = (uint8_t *)mbuf_data(m);
+	memcpy(f, dst, ETHER_ADDR_LEN);
+	memcpy(f + ETHER_ADDR_LEN, ud_phone_mac, ETHER_ADDR_LEN);
+	f[12] = (UD_CTL_TYPE >> 8) & 0xff;
+	f[13] = UD_CTL_TYPE & 0xff;
+	memcpy(f + ETHER_HDR_LEN, text, len);
+	mbuf_setlen(m, flen);
+	mbuf_pkthdr_setlen(m, flen);
+
+	lck_mtx_lock(ud.lock);
+	if (!ud.configured || ud.txq_count == UD_TXQ) {
+		lck_mtx_unlock(ud.lock);
+		mbuf_freem(m);
+		return;
+	}
+	ud.txq[(ud.txq_head + ud.txq_count) % UD_TXQ] = m;
+	ud.txq_count++;
+	ud_tx_kick_locked();
+	lck_mtx_unlock(ud.lock);
 }
 
