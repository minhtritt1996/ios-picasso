+/* READ <path> <off> <len>: one ranged read, so multi-GB files need no full GET. */
+static int
+sf_read(socket_t so, const char *path, off_t start, size_t len)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (!err) {
+		err = vnode_size(vp, &size, ctx);
+	}
+	if (!err && start >= size) {
+		err = 0;
+		len = 0;
+	}
+	if (!err && (off_t)len > size - start) {
+		len = (size_t)(size - start);
+	}
+	if (!err && len > SF_BUF) {
+		len = SF_BUF;
+	}
+	if (err) {
+		if (vp != NULLVP) {
+			vnode_close(vp, FREAD, ctx);
+		}
+		sf_reply(so, err, 0, false);
+		return err;
+	}
+	sf_reply(so, 0, (uint64_t)len, true);
+	if (len) {
+		int resid = 0;
+		err = vn_rdwr(UIO_READ, vp, sf_buf, (int)len, start, UIO_SYSSPACE, IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!err) {
+			err = sf_send(so, sf_buf, len - (size_t)resid);
+		}
+	}
+	vnode_close(vp, FREAD, ctx);
+	return err;
+}
