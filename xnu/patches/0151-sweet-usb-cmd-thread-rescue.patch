+
+/*
+ * A command that touches the filesystem can block for ever on this port (the UFS
+ * path wedges), and because there is one command thread, that also stops `info`
+ * and `log` - which are exactly the commands needed to debug such a boot. So a
+ * command thread stuck for three seconds is abandoned and another is started: the
+ * channel keeps answering, and only the wedged command loses its reply.
+ */
+void
+sweet_usb_cmd_rescue(void)
+{
+	if (__predict_false(ud.dma == 0 || ud.cmd_threads >= 4)) {
+		return;
+	}
+	if (!ud.cmd_busy || ud.cmd_stamp == 0) {
+		return;
+	}
+	uint64_t age = mach_absolute_time() - ud.cmd_stamp;
+	uint64_t ns = 0;
+	thread_t t = NULL;
+
+	absolutetime_to_nanoseconds(age, &ns);
+	if (ns < 3000000000ULL) {
+		return;
+	}
+	ud.cmd_busy = false;            /* the wedged thread keeps its own copy */
+	if (kernel_thread_start(ud_cmd_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+		os_atomic_inc(&ud.cmd_threads, relaxed);
+		if (ud.cmd_rescues++ < 8) {
+			ud_log("SWEET USB: command stuck %llu ms, started cmd thread %u\n",
+			    ns / 1000000, ud.cmd_threads);
+		}
+	}
+}
