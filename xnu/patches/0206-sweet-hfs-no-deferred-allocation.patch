--- a/bsd/sweet_hfs/core/FileExtentMapping.c
+++ b/bsd/sweet_hfs/core/FileExtentMapping.c
@@ -889,10 +889,29 @@
 	/*
 	 * For deferred allocations just reserve the blocks.
