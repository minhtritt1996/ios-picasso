sweet ufs: say where the strategy path sits inside the UFS lock

bp16 wedged with the heartbeat reporting "lk 4/1 ... age 0 ms" for the
rest of the boot: the file I/O path took sweet_ufs_lock and never gave it
back, while no SCSI command was outstanding, so it is not waiting for the
controller.  Its ring also shows the flusher stopping at 8.5 s, inside
"exec launchd_cache_loader", i.e. the wedge happens on an ordinary HFS
read of the dyld cache and not later.

Record the step inside that block (1 taken, 2 before the read, 3 after
it, 4 after the copy out, 5 before the unlock, 6 after it) plus the buf
block number, byte count and thread id, and print them with the holder's
thread id in the heartbeat.  A stuck boot then names the exact statement
instead of "somewhere under the lock".
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -129,11 +129,20 @@
 	 * owner frozen names the path that never released. */
 	volatile uint32_t lock_owner;
 	volatile uint32_t lock_users;
+	volatile uint32_t lock_tid;
 	volatile uint32_t flush_stage;
 	/* Where a GPT partition lookup is right now: the heartbeat prints it, so
 	 * a lookup that never returns names its own LUN and step. */
 	volatile uint32_t part_lun;
 	volatile uint32_t part_step;
+	/* Where the strategy (file I/O) path is inside the lock: it holds
+	 * sweet_ufs_lock and issues one command at a time, so a boot that stops
+	 * with owner 4 and no command outstanding is stuck in memcpy or in the
+	 * unlock.  Printed by the heartbeat. */
+	volatile uint32_t strat_step;
+	volatile uint64_t strat_blk;
+	volatile uint32_t strat_count;
+	volatile uint32_t strat_tid;
 	char want[24];                          /* root partition name, boot-arg ufsroot */
 } su;
 
@@ -149,6 +158,7 @@
 	lck_mtx_lock(&sweet_ufs_lock);
 	su.lock_owner = who;
 	su.lock_users++;
+	su.lock_tid = (uint32_t)thread_tid(current_thread());
 }
 
 static inline void
@@ -156,6 +166,7 @@
 {
 	su.lock_users--;
 	su.lock_owner = 0;
+	su.lock_tid = 0;
 	lck_mtx_unlock(&sweet_ufs_lock);
 }
 
@@ -775,8 +786,13 @@
