 	ufs_lock(UFS_LK_STRATEGY);
 	for (uint32_t done = 0; done < count;) {
+		su.strat_step = 2;
 		uint64_t pos = off + done;
 		uint64_t lba = pos / UFS_BLOCK;
 		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
@@ -785,8 +801,10 @@
 		void *bounce = (void *)(su.dma + DMA_BOUNCE);
