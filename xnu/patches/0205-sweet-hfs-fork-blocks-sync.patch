--- a/bsd/sweet_hfs/core/hfs_vnops.c
+++ b/bsd/sweet_hfs/core/hfs_vnops.c
@@ -6210,8 +6210,31 @@
 	if (!TAILQ_EMPTY(&ff->ff_invalidranges))
 		max_size = TAILQ_FIRST(&ff->ff_invalidranges)->rl_start;
 
-	if (!ff->ff_unallocblocks && ff->ff_size <= max_size)
-		return cf; // Nothing to do
+	if (!ff->ff_unallocblocks && ff->ff_size <= max_size) {
+		/*
+		 * SWEET: ff_data (the cat_fork copied from the catalog record when the
+		 * vnode was created) is never refreshed by the write path on this port;
+		 * FileExtendFile updates ff_blocks and c_blocks, and then this "nothing
+		 * to do" return hands CatUpdate the stale record. The catalog then keeps
+		 * size = N with totalBlocks = 0, and the next hfs_getnewvnode blows up in
+		 * its sanity check (bsd/sweet_hfs/core/hfs_cnode.c: howmany(cf_size,
+		 * block_size) > cf_blocks), marking the volume corrupt - which is exactly
+		 * what a running daemon population triggers within seconds.
+		 *
+		 * Sync the numeric fields from the live fork before returning; the extent
+		 * list still comes from cf, since extents live in the extent records.
+		 */
+		struct cat_fork *out = cf_buf;
+
+		if (out != cf) {
+			bcopy(cf, out, sizeof(*cf));
+		}
+		if (out->cf_size != ff->ff_size || out->cf_blocks != ff->ff_blocks) {
+			out->cf_size = ff->ff_size;
+			out->cf_blocks = ff->ff_blocks - ff->ff_unallocblocks;
+		}
+		return out;
+	}
 
 	if (ff->ff_blocks < ff->ff_unallocblocks) {
 		panic("hfs: ff_blocks %d is less than unalloc blocks %d\n",
