+	/*
+	 * A panic must not disappear into a muted console.  XNU prints it
+	 * through this path only when debug does not contain DB_KPRT, so the
+	 * text itself is the trigger: the first chunk that carries "panic(cpu"
+	 * flushes the ring to the partition and unmutes the console, which then
+	 * draws the whole panic report.
+	 */
+	{
+		static int panic_seen;
+		if (!panic_seen && size > 0 && c[size - 1] == '\0' &&
+		    __builtin_strstr(c, "panic(cpu") != NULL) {
+			panic_seen = 1;
+			sweet_console_muted = 0;
+			sweet_ufs_panic_dump();
+		}
+		if (panic_seen) {
+			sweet_console_muted = 0;
+		}
 	}
