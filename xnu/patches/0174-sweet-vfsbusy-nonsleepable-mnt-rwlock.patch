--- a/bsd/vfs/vfs_subr.c
+++ b/bsd/vfs/vfs_subr.c
@@ -81,6 +81,8 @@
 #include <sys/systm.h>
 #include <sys/proc_internal.h>
 #include <sys/kauth.h>
+#include <kern/cpu_data.h>
+#include <kern/lock_rw.h>
 #include <sys/mount_internal.h>
 #include <sys/time.h>
 #include <sys/lock.h>
@@ -1069,6 +1071,32 @@
 
 	mount_unlock(mp);
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * SWEET: a mount reaches vfs_busy() with an mnt_rwlock that reports
+	 * lck_rw_can_sleep == false, i.e. it was never lck_rw_init()ed (or was
+	 * destroyed and re-zeroed). Taking a non-sleepable rwlock requires
+	 * preemption to be disabled, otherwise lock_rw.c panics with "Taking
+	 * non-sleepable RW lock with preemption enabled" on the first userland
+	 * path lookup (dropbear exec, tid 250). Name the mount once and take
+	 * the lock the way lock_rw.c expects for a non-sleepable lock.
+	 */
+	if (!lck_rw_is_sleepable(&mp->mnt_rwlock)) {
+		static int sweet_vfsbusy_logged;
+
+		if (!sweet_vfsbusy_logged) {
+			sweet_vfsbusy_logged = 1;
+			printf("SWEET VFS: vfs_busy on non-sleepable mnt_rwlock "
+			    "mp %p fs %s flags 0x%x lflag 0x%x rootfs %d lock %p\n",
+			    mp, mp->mnt_vtable ? mp->mnt_vtable->vfc_name : "?",
+			    mp->mnt_flag, mp->mnt_lflag,
+			    !!(mp->mnt_flag & MNT_ROOTFS), &mp->mnt_rwlock);
+		}
+		disable_preemption();
+		lck_rw_lock_shared(&mp->mnt_rwlock);
+		enable_preemption();
+	} else
+#endif /* ARM64_BOARD_CONFIG_SWEET */
 	lck_rw_lock_shared(&mp->mnt_rwlock);
 
 	/*
@@ -1088,6 +1116,14 @@
 void
 vfs_unbusy(mount_t mp)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	if (!lck_rw_is_sleepable(&mp->mnt_rwlock)) {
+		disable_preemption();
+		lck_rw_done(&mp->mnt_rwlock);
+		enable_preemption();
+		return;
+	}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
 	lck_rw_done(&mp->mnt_rwlock);
 }
 
--- a/osfmk/kern/lock_rw.c
+++ b/osfmk/kern/lock_rw.c
@@ -188,6 +188,17 @@
 	lck_grp_reference(grp, &grp->lck_grp_rwcnt);
 }
 
+/*
+ * SWEET: bsd/ cannot read the can_sleep bit of an opaque lck_rw_t.
+ * A lock that reports false here was never lck_rw_init()ed, so taking it
+ * requires preemption to be disabled. @see lck_rw_init().
+ */
+bool
+lck_rw_is_sleepable(const lck_rw_t *lck)
+{
+	return lck->lck_rw_can_sleep;
+}
+
 /*!
  * @function lck_rw_free
  *
--- a/osfmk/kern/lock_rw.h
+++ b/osfmk/kern/lock_rw.h
@@ -111,6 +111,15 @@
 typedef struct __lck_rw_t__     lck_rw_t;
 #endif /* !KERNEL_PRIVATE */
 
+#ifdef KERNEL_PRIVATE
+/*
+ * SWEET: bsd/ code sees the opaque lck_rw_t, so it cannot check the
+ * can_sleep bit itself. vfs_busy() needs it because a mount can reach it
+ * with an mnt_rwlock that was never lck_rw_init()ed. @see lck_rw_init().
+ */
+extern bool lck_rw_is_sleepable(const lck_rw_t *lck);
+#endif /* KERNEL_PRIVATE */
+
 #if DEVELOPMENT || DEBUG
 #ifdef XNU_KERNEL_PRIVATE
 
