+/*
+ * One-byte write through the same observer lane the reads use: clear the read
+ * bit, byte count 1, data byte in bits 23:16. Used to set the PON spare byte
+ * that ABL reads to choose fastboot/recovery.
+ */
+static bool
+keys_write(uint16_t apid, uint16_t addr, uint8_t value)
+{
+	if (apid == KEYS_NO_APID) {
+		return false;
+	}
+	uint32_t off = 0x80u * apid;
+	uint32_t cmd = ((uint32_t)value << 16) | (1u << 17) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(keys_obs + off) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		keys_last_status = keys_rd(keys_obs, off + 0x08u);
+		if (keys_last_status & 1u) {
+			return (keys_last_status & 0x0eu) == 0;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* Raw write of a command dword to the PON lane, for probing the controller's
+ * write encoding at runtime (read the register back to see what stuck). */
+int
+sweet_pon_raw(uint32_t cmd, uint32_t *status, uint8_t *data)
+{
+	if (keys_pon_apid == KEYS_NO_APID) {
+		return -1;
+	}
+	uint32_t off = 0x80u * keys_pon_apid;
+
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(keys_obs + off) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t st = keys_rd(keys_obs, off + 0x08u);
+
+		if (st & 1u) {
+			if (status != NULL) {
+				*status = st;
+			}
+			if (data != NULL) {
+				*data = (uint8_t)keys_rd(keys_obs, off + 0x18u);
+			}
+			return (st & 0x0eu) ? -2 : 0;
+		}
+		delay(1);
+	}
+	return -3;
+}
+
+/* PON block access for the reboot path (fastboot/recovery reason byte). */
+int
+sweet_pon_read(unsigned addr, uint8_t *out)
+{
+	return keys_read(keys_pon_apid, (uint16_t)addr, out) ? 0 : -1;
+}
+
+int
+sweet_pon_write(unsigned addr, uint8_t value)
+{
+	return keys_write(keys_pon_apid, (uint16_t)addr, value) ? 0 : -1;
+}
