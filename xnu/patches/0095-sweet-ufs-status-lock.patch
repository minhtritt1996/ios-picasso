+	/* Who holds sweet_ufs_lock right now, and where the flusher is.  A boot
+	 * that stops doing file I/O shows this in the heartbeat: users > 0 with
+	 * owner frozen names the path that never released. */
+	volatile uint32_t lock_owner;
+	volatile uint32_t lock_users;
