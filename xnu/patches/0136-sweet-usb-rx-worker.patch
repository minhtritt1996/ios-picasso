+/*
+ * RX worker: everything the stack does with a received frame happens here -
+ * ifnet_input, the control-channel dispatch - so that a blocking path in the
+ * network stack can never stop the USB event thread (which is what used to take
+ * the whole link down).
+ */
+static void
+ud_rx_worker(void *arg __unused, wait_result_t wr __unused)
+{
+	uint8_t frame[ETHER_MAX_LEN];
+	uint32_t len;
+	for (;;) {
+		lck_mtx_lock(ud.lock);
+		if (ud.rxq_count == 0) {
+			assert_wait(&ud.rxq_pending, THREAD_UNINT);
+			lck_mtx_unlock(ud.lock);
+			thread_block(THREAD_CONTINUE_NULL);
+			continue;
+		}
+		uint32_t slot = ud.rxq_head;
+		len = ud.rxq_len[slot];
+		memcpy(frame, ud.rxq_buf[slot], len);
+		ud.rxq_head = (ud.rxq_head + 1) % UD_RXQ;
+		ud.rxq_count--;
+		if (ud.rxq_count == 0) {
+			ud.rxq_pending = false;
+		}
+		lck_mtx_unlock(ud.lock);
+
+		if (len > ETHER_HDR_LEN && frame[12] == ((UD_CTL_TYPE >> 8) & 0xff) &&
+		    frame[13] == (UD_CTL_TYPE & 0xff)) {
+			char cmd[1200];
