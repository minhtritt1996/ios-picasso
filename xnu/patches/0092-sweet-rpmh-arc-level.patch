+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	/* PMIC5 LDO: HPM (raw mode 7), enable last. */
+	static const uint32_t offsets[3] = { 0, 8, 4 };
+	const uint32_t values[3] = { mv, 7, 1 };
+
+	return rh_send_cmds(address, offsets, values, 3, "mV");
+}
+
+/*
+ * RPMh ARC resources ("cx.lvl", "mss.lvl") take a *level* at address + 0.
+ * The vendor PIL votes them before auth_and_reset; without them the modem runs
+ * at whatever corner the bootloader left, which may be too low for its WLAN.
+ */
+int
+sweet_rpmh_arc_level(const char *res, unsigned level)
+{
+	uint32_t address = 0;
+	static const uint32_t offsets[1] = { 0 };
+	const uint32_t values[1] = { level };
+	int error = EIO;
+
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send_cmds(address, offsets, values, 1, res);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: arc %s level %u failed errno=%d\n", res, level, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
