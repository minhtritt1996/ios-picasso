+
+/*
+ * A single blocking ifnet_input() starves the whole receive side: the worker
+ * thread never returns, so no further frame - control frames included - is ever
+ * dispatched, while the USB stack itself stays healthy (the ring still drains,
+ * the TRB stays armed). Rather than guess where the stack blocks, start another
+ * worker: the stuck one leaks, the queue keeps draining. Bounded so a pathological
+ * stack cannot spawn threads forever.
+ */
+void
+sweet_usb_rx_rescue(void)
+{
+	if (ud.dma == 0 || !ud.configured || ud.rxw_threads >= 4) {
+		return;
+	}
+	if (ud.rxw_enter == ud.rxw_returned) {
+		return;
+	}
+	uint64_t age = mach_absolute_time() - ud.rxw_stamp;
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(age, &ns);
+	if (ns < 2000000000ULL) {
+		return;
+	}
+	thread_t t = NULL;
+
+	if (kernel_thread_start(ud_rx_worker, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+		os_atomic_inc(&ud.rxw_threads, relaxed);
+		if (ud.rxw_rescues++ < 8) {
+			ud_log("SWEET USB: rx worker stuck %llu ms, started worker %u\n",
+			    ns / 1000000, ud.rxw_threads);
+		}
+	}
+}
