From 2e3431787de0d99d90aee3d36ca276c342eb8f6d Mon Sep 17 00:00:00 2001
From: test <test@test>
Date: Wed, 21 Oct 2026 20:54:14 +0700
Subject: [PATCH 1/3] xnu 0085: real dcache clean/flush for Qualcomm display
 (MDP)

---
 iokit/Kernel/arm/SweetFramebuffer.cpp |  3 ++
 osfmk/arm/caches.c                    | 55 +++++++++++++++++++++++++++
 2 files changed, 58 insertions(+)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index a62416c..b6ebfec 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -36,6 +36,7 @@
  */
 #include "SweetSurface.h"
 
+extern "C" void sweet_dcache_clean(vm_offset_t addr, unsigned length);  /* osfmk/arm/caches.c */
 extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
 
 #if defined(SWEET)
@@ -396,6 +397,8 @@ AppleCLCD::present(const uint8_t *rec)
 				    (const void *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4),
 				    (size_t)w * 4);
 			}
+			sweet_dcache_clean((vm_offset_t)(fPixels + (uint64_t)dy * fRowBytes),
+			    (unsigned)((uint64_t)h * fRowBytes));
 		}
 		s->release();
 	}
diff --git a/osfmk/arm/caches.c b/osfmk/arm/caches.c
index b5b3ba9..cd348fb 100644
--- a/osfmk/arm/caches.c
+++ b/osfmk/arm/caches.c
@@ -382,6 +382,60 @@ platform_cache_flush_wimg(
 
 #else   /* __ARM_COHERENT_IO__ */
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * topaz/sweet: Apple SoCs keep DMA coherent with the CPU caches, so these
+ * are no-ops upstream. The Qualcomm display (MDP) and other masters here
+ * read DRAM behind the caches: clean/invalidate to the point of coherency.
+ */
+static void
+sweet_dcache_op(vm_offset_t addr, unsigned length, boolean_t phys, bool invalidate)
+{
+	if (length == 0) {
+		return;
+	}
+	if (phys) {
+		addr = phystokv((pmap_paddr_t)addr);
+	}
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	vm_offset_t line = 4UL << ((ctr >> 16) & 0xf);
+	vm_offset_t end = addr + length;
+	__builtin_arm_dsb(DSB_SY);
+	for (vm_offset_t va = addr & ~(line - 1); va < end; va += line) {
+		if (invalidate) {
+			__asm__ volatile ("dc civac, %0" :: "r"(va) : "memory");
+		} else {
+			__asm__ volatile ("dc cvac, %0" :: "r"(va) : "memory");
+		}
+	}
+	__builtin_arm_dsb(DSB_SY);
+}
+
+void
+flush_dcache(vm_offset_t addr, unsigned length, boolean_t phys)
+{
+	sweet_dcache_op(addr, length, phys, true);
+}
+
+void
+clean_dcache(vm_offset_t addr, unsigned length, boolean_t phys)
+{
+	sweet_dcache_op(addr, length, phys, false);
+}
+
+void
+sweet_dcache_clean(vm_offset_t addr, unsigned length)
+{
+	sweet_dcache_op(addr, length, false, false);
+}
+
+void
+sweet_dcache_flush(vm_offset_t addr, unsigned length)
+{
+	sweet_dcache_op(addr, length, false, true);
+}
+#else
 void
 flush_dcache(
 	__unused vm_offset_t addr,
@@ -399,6 +453,7 @@ clean_dcache(
 {
 	__builtin_arm_dsb(DSB_SY);
 }
+#endif
 
 void
 flush_dcache_syscall(
