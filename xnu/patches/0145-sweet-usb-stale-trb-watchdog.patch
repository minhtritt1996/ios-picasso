 /* ---- network interface (ue0) ---- */
 
+/* Free whatever is queued for TX (call with ud.lock held). The queue is a
+ * head-plus-count ring, so zeroing the indices alone would leak the mbufs. */
 static void
+ud_txq_drain(void)
+{
+	while (ud.txq_count > 0) {
+		mbuf_t m = ud.txq[ud.txq_head];
+
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		ud.tx_drops++;
+	}
+	ud.txq_head = 0;
+}
