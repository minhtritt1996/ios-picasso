--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -89,8 +89,8 @@
 	/* Restrict access to the battery blocks; keys retain their own lanes. */
 	unsigned peripheral = addr >> 8;
 	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
-	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
-	    peripheral != 0x13 && peripheral != 0x48)) {
+	    (peripheral != 0x08 && peripheral != 0x10 && peripheral != 0x11 &&
+	    peripheral != 0x12 && peripheral != 0x13 && peripheral != 0x48)) {
 		return -1;
 	}
 	IOLockLock(sp_lock);
@@ -123,4 +123,47 @@
 	IOLockUnlock(sp_lock);
 	return -1;
 }
+/*
+ * One-byte SPMI write. Same lane/APID lookup as the read; the command dword has
+ * the read bit clear and byte count 1, with the data byte in bits 23:16. Used to
+ * set the PMIC PON spare byte that ABL reads to pick fastboot or recovery.
+ */
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	unsigned peripheral = addr >> 8;
+	if (!sp_ready || sid != 0 || addr > 0xffffu ||
+	    (peripheral != 0x08 && peripheral != 0x10 && peripheral != 0x11 &&
+	    peripheral != 0x12 && peripheral != 0x13 && peripheral != 0x48)) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned off = 0x80u * apid;
+	uint32_t cmd = ((uint32_t)value << 16) | (1u << 17) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd;      /* write, BC = 1 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				IOLockUnlock(sp_lock);
+				return -1;
+			}
+			IOLockUnlock(sp_lock);
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: SPMI write timeout sid=%u addr=%#x APID=%u disabled\n",
+	    sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
--- a/bsd/dev/sweet_spmi.h
+++ b/bsd/dev/sweet_spmi.h
@@ -8,6 +8,8 @@
 int sweet_spmi_init(void);
 /* Thread context only; 0 success, -1 failure; *out unchanged on failure. */
 int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+/* One-byte write (PON spares); thread context only; 0 success, -1 failure. */
+int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value);
 #ifdef __cplusplus
 }
 #endif
