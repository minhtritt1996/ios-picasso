+
+/*
+ * Force the usb30_prim power domain and the USB GCC clocks back on. A DWC3
+ * register read stalls the CPU forever when the block loses its clock or power,
+ * so the only way to tell a gated block from a wedged thread is to vote the
+ * clocks from a thread that still runs and then read a register.
+ */
+static void
+ud_usb_power_on(void)
+{
+	if (ud_gcc == 0) {
+		return;
+	}
+	uint32_t gdscr = usb_rd(ud_gcc, GCC_USB30_PRIM_GDSCR);
+	if (!(gdscr & (1u << 31))) {
+		*(volatile uint32_t *)(ud_gcc + GCC_USB30_PRIM_GDSCR) = gdscr & ~1u;
+		for (int c = 0; c < 1000 && !(usb_rd(ud_gcc, GCC_USB30_PRIM_GDSCR) & (1u << 31)); c++) {
+			delay(10);
+		}
+	}
+	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
+		uint32_t v = usb_rd(ud_gcc, usb_cbcr[i].off);
+		if (v & CBCR_CLK_OFF) {
+			*(volatile uint32_t *)(ud_gcc + usb_cbcr[i].off) = v & ~CBCR_CLK_OFF;
+		}
+	}
+}
 static int ud_stall_panic;       /* sweetusbstallpanic=1: panic on a stalled event thread */
 
