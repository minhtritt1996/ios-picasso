+/*
+ * The kick thread runs this on a timer.  When the driver is healthy the ring
+ * must be written under the same lock as every other command: without it the
+ * dump memcpy()s into the bounce buffer and rings slot 0 while a read is in
+ * flight, and that read then returns ring text instead of file data (bp34 died
+ * in load_init_program() that way).  Only when the lock is already stuck - the
+ * case this thread exists for - write without it.
+ */
 int
 sweet_ufs_emergency_dump(void)
 {
+	int error;
+
+	if (lck_mtx_try_lock(&sweet_ufs_lock)) {
+		su.lock_owner = UFS_LK_FLUSH;
+		su.lock_users++;
+		su.lock_tid = (uint32_t)thread_tid(current_thread());
+		error = sweet_ufs_dump_ring(true);
+		su.lock_users--;
+		su.lock_owner = 0;
+		su.lock_tid = 0;
+		lck_mtx_unlock(&sweet_ufs_lock);
+		return error;
+	}
 	return sweet_ufs_dump_ring(false);
 }
 
