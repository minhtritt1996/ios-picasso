+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * Mirror the console on the panel.
+ *
+ * The kernel console goes out of the UART, which nothing can read on this
+ * board, so the early boot is invisible: the screen stays black and the
+ * only sign of life is that the persistent log never starts. With
+ * boot-arg sweetpanel=<address> the same characters are drawn into the
+ * panel memory - the memory the framebuffer driver later publishes as its
+ * surface - so a photograph of the screen shows what the kernel says.
+ *
+ * The font is the one the video console uses (osfmk/console/iso_font.c);
+ * the panel is 1080x2400 with four bytes per pixel.
+ */
+extern unsigned char iso_font[256 * 16];
+/* The panel is not inside the kernel's own window, so it has to be mapped
+ * before it can be written to; ml_io_map is what the storage driver uses
+ * for the same reason. */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define SWEET_PANEL_WIDTH   1080
+#define SWEET_PANEL_HEIGHT  2400
+
+static uintptr_t sweet_panel_base;
+static vm_offset_t sweet_panel_map;
+static uint32_t sweet_panel_x, sweet_panel_y;
+static bool sweet_panel_looked;
+
+static uint64_t
+sweet_panel_address(const char *s)
+{
+	uint64_t v = 0;
+	for (int i = 0; s[i]; i++) {
+		char c = s[i];
+		uint64_t d;
+		if (c >= '0' && c <= '9')
+			d = (uint64_t)(c - '0');
+		else if (c >= 'a' && c <= 'f')
+			d = (uint64_t)(c - 'a' + 10);
+		else if (c >= 'A' && c <= 'F')
+			d = (uint64_t)(c - 'A' + 10);
+		else
+			return 0;
+		v = (v << 4) | d;
+	}
+	return v;
+}
+
+static void
+sweet_panel_putc(char ch)
+{
+	if (!sweet_panel_looked) {
+		char arg[32];
+		sweet_panel_looked = true;
+		if (PE_parse_boot_argn("sweetpanel", arg, sizeof(arg)))
+			sweet_panel_base = (uintptr_t)sweet_panel_address(arg);
+	}
+	if (!sweet_panel_base)
+		return;
+	if (!sweet_panel_map) {
+		/* The vm is not up for the first messages; try again later. */
+		sweet_panel_map = ml_io_map((vm_offset_t)sweet_panel_base,
+		    SWEET_PANEL_WIDTH * SWEET_PANEL_HEIGHT * 4);
+		if (!sweet_panel_map)
+			return;
+	}
+
+	if (ch == '\r')
+		return;
+	if (ch == '\n') {
+		sweet_panel_x = 0;
+		sweet_panel_y += 16;
+		return;
+	}
+	if (sweet_panel_x + 8 > SWEET_PANEL_WIDTH) {
+		sweet_panel_x = 0;
+		sweet_panel_y += 16;
+	}
+	if (sweet_panel_y + 16 > SWEET_PANEL_HEIGHT)
+		return;
+	uint32_t *row = (uint32_t *)(sweet_panel_map +
+	    (uint64_t)sweet_panel_y * SWEET_PANEL_WIDTH * 4);
+	const unsigned char *glyph = iso_font + ((uint8_t)ch) * 16;
+	for (int gy = 0; gy < 16; gy++) {
+		uint32_t bits = glyph[gy];
+		for (int gx = 0; gx < 8; gx++) {
+			if (bits & (0x80u >> gx))
+				row[sweet_panel_x + gx] = 0xffffffffu;
+		}
+	}
+	sweet_panel_x += 8;
+}
+#endif
+
 static inline void
 _cnputc(char c, bool poll)
 {
@@ -254,6 +348,7 @@
 		_cnputc('\r', poll);
 	}
 
+	sweet_panel_putc(c);
 	cons_ops[idx].putc(c, poll);
 }
 
