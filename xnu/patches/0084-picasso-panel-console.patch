--- a/osfmk/console/serial_console.c	2026-10-21 13:40:52.452449659 +0700
+++ b/osfmk/console/serial_console.c	2026-10-21 16:14:55.550966059 +0700
@@ -242,6 +242,81 @@
  * @param poll Whether or not this call should poll instead of going to sleep
  *             waiting for an interrupt when the hardware device isn't ready
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * Mirror the console on the panel.
+ *
+ * The same characters the console writes are drawn into the panel memory -
+ * the memory the framebuffer driver later publishes as its surface - so a
+ * photograph of the screen shows what the kernel says. The text is drawn at
+ * the bottom of the panel and grows upwards, so it does not fight with the
+ * video console (which draws at the top).
+ *
+ * The panel is mapped by arm_init() once the vm is up; see the comment
+ * there. Nothing here allocates or maps anything.
+ */
+extern unsigned char iso_font[256 * 16];
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+static uintptr_t sweet_panel_va;
+static uint32_t sweet_panel_w, sweet_panel_h, sweet_panel_stride;
+static uint32_t sweet_panel_x, sweet_panel_y;
+static bool sweet_panel_on;
+
+void
+sweet_panel_map_console(vm_offset_t phys, vm_size_t size,
+    uint32_t width, uint32_t height, uint32_t stride)
+{
+	uintptr_t va = (uintptr_t)ml_io_map(phys, size);
+
+	if (!va)
+		return;
+	sweet_panel_va = va;
+	sweet_panel_w = width;
+	sweet_panel_h = height;
+	sweet_panel_stride = stride;
+	sweet_panel_x = 0;
+	sweet_panel_y = height > 16 ? height - 16 : 0;
+	sweet_panel_on = true;
+}
+
+static void
+sweet_panel_newline(void)
+{
+	sweet_panel_x = 0;
+	if (sweet_panel_y < 16)
+		sweet_panel_y = sweet_panel_h - 16;
+	else
+		sweet_panel_y -= 16;
+}
+
+static void
+sweet_panel_putc(char ch)
+{
+	if (!sweet_panel_on)
+		return;
+	if (ch == '\r')
+		return;
+	if (ch == '\n') {
+		sweet_panel_newline();
+		return;
+	}
+	if (sweet_panel_x + 8 > sweet_panel_w)
+		sweet_panel_newline();
+	uint32_t *row = (uint32_t *)(sweet_panel_va +
+	    (uint64_t)sweet_panel_y * sweet_panel_stride);
+	const unsigned char *glyph = iso_font + ((uint8_t)ch) * 16;
+	for (int gy = 0; gy < 16; gy++) {
+		uint32_t bits = glyph[gy];
+		for (int gx = 0; gx < 8; gx++) {
+			if (bits & (1u << gx))
+				row[sweet_panel_x + gx] = 0xffffffffu;
+		}
+	}
+	sweet_panel_x += 8;
+}
+#endif
+
