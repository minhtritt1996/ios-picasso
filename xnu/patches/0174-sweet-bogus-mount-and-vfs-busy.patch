+/*
+ * SWEET: bsd/ cannot read the can_sleep bit of an opaque lck_rw_t.
+ * Returns false for a lock that was never lck_rw_init()ed.
+ */
+bool
+lck_rw_is_sleepable(const lck_rw_t *lck)
+{
+	return lck->lck_rw_can_sleep;
+}
