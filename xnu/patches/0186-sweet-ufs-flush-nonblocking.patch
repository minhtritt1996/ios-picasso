+static inline bool
+ufs_trylock(uint32_t who)
+{
+	if (!lck_mtx_try_lock(&sweet_ufs_lock)) {
+		return false;
+	}
+	su.lock_owner = who;
+	su.lock_users++;
+	su.lock_tid = (uint32_t)thread_tid(current_thread());
+	return true;
