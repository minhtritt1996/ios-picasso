+/* A one-line state report for the USB control channel, so a stalled system can still
+ * say who holds the driver lock and at which step, without going through the log. */
+void
+sweet_ufs_state(char *out, size_t max)
+{
+	snprintf(out, max, "lock %u/%u tid %u strat step %u blk 0x%llx c %llu done %u "
+	    "flush %u err %d tail %u\n",
+	    (unsigned)su.lock_owner, (unsigned)su.lock_users, (unsigned)su.lock_tid,
+	    (unsigned)su.strat_step, (unsigned long long)su.strat_blk,
+	    (unsigned long long)su.strat_count, (unsigned)su.strat_done,
+	    (unsigned)su.flush_stage, su.last_err, (unsigned)sweet_tail_seq_g);
+}
+
+#define SWEET_TAIL_BLOCKS 16
+
+/*
+ * Persist the last 64 KiB of the ring every second to a fixed block range, one
+ * command, no header update: a stall can then always be read back from recovery.
+ * The chunked flusher only updates its header when a whole round completes, which
+ * is exactly what loses the final seconds of a wedged boot.
+ */
 static void
+sweet_tail_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	while (!su.ready || !su.writable || sweet_log_base_g == 0) {
+		(void)tsleep(&sweet_log_chan, PZERO, "sweettail", hz);
+	}
+	uint64_t tail_blk = sweet_log_base_g - 32;
+	printf("SWEET TAIL: last %u KiB at block 0x%llx\n",
+	    (unsigned)(SWEET_TAIL_BLOCKS * UFS_BLOCK >> 10), tail_blk);
+	for (;;) {
+		(void)tsleep(&sweet_log_chan, PZERO, "sweettail", hz);
+		uint64_t total = sweet_log_position();
+		uint32_t bytes = SWEET_TAIL_BLOCKS * UFS_BLOCK;
+		if (total == 0) {
+			continue;
+		}
+		if (!ufs_trylock(UFS_LK_TAIL)) {
+			continue;
+		}
+		uint64_t start = total > bytes ? total - bytes : 0;
+		sweet_log_copy(&start, (char *)(su.dma + DMA_BOUNCE), bytes);
+		int err = ufs_write_blocks(tail_blk, SWEET_TAIL_BLOCKS);
+		ufs_unlock();
+		if (!err) {
+			sweet_tail_seq_g++;
+		}
+	}
+}
