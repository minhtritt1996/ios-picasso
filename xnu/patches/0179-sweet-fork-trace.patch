--- a/bsd/kern/kern_fork.c
+++ b/bsd/kern/kern_fork.c
@@ -620,7 +620,20 @@
 		}
 
 		/* "Return" to the child */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		{
+			static int sweet_fork_prints = 64;
+			task_clear_return_wait(get_threadtask(child_thread), TCRW_CLEAR_ALL_WAIT);
+			if (sweet_fork_prints > 0) {
+				sweet_fork_prints--;
+				printf("SWEET FORK %s pid %d -> child %d released\n",
+				    parent_proc->p_comm, proc_getpid(parent_proc),
+				    proc_getpid(child_proc));
+			}
+		}
+#else
 		task_clear_return_wait(get_threadtask(child_thread), TCRW_CLEAR_ALL_WAIT);
+#endif
 
 		/* drop the extra references we got during the creation */
 		task_deallocate(child_task);
