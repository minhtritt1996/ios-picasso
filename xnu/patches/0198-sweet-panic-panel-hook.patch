--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1075,6 +1075,22 @@
 #if defined(SWEET)
 	/* No CPU/thread/debugger state is required for this first panic copy. */
 	sweet_early_panic(panic_format_str, panic_args);
+	/*
+	 * The panel console scrolls upwards, so a multi-screen panic dump used to
+	 * leave only "panic(cpu N caller 0x...):" visible and the reason lost.
+	 * Switch it to top-down before the dump is printed.
+	 */
+	{
+		extern void sweet_panel_begin_panic(void);
+		extern void sweet_ufs_panic_mark(const char *);
+		char pbuf[240];
+
+		sweet_panel_begin_panic();
+		/* The reason must survive even if the ring flush fails: one raw block
+		 * at the end of the partition, readable from recovery. */
+		snprintf(pbuf, sizeof(pbuf), "caller %lx fmt: %s", panic_caller, panic_format_str);
+		sweet_ufs_panic_mark(pbuf);
+	}
 #endif
 
 #if defined(__x86_64__) && (DEVELOPMENT || DEBUG)
