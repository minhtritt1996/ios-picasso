--- a/osfmk/arm64/bsd_arm64.c
+++ b/osfmk/arm64/bsd_arm64.c
@@ -278,6 +278,40 @@
 #endif /* CONFIG_DEBUG_SYSCALL_REJECTION */
 
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * The BSD syscall trace never fires for xpcproxy: dyld's start-up calls
+	 * MACH TRAPS (thread_self_trap, mach_msg_trap), not unix syscalls. Trace
+	 * those with their arguments so a trap that never returns is visible.
+	 */
+	{
+		extern struct proc *current_proc(void);
+		extern int proc_pid(struct proc *);
+		extern const char *proc_best_name(struct proc *);
+		struct proc *cp = current_proc();
+		const char *cnm = cp != NULL ? proc_best_name(cp) : NULL;
+
+		if (cnm != NULL && cnm[0] == 'x' && strcmp(cnm, "xpcproxy") == 0) {
+			static int sweet_mt_prints = 240;
+
+			if (sweet_mt_prints > 0) {
+				sweet_mt_prints--;
+				{
+					extern const char *const mach_syscall_name_table[];
+					const char *tn = (call_number < 128) ?
+					    mach_syscall_name_table[call_number] : "?";
+
+					printf("SWEET MTRAP xpcproxy n=%d %s a1 %#llx a2 %#llx a3 %#llx\n",
+					    call_number, tn ? tn : "?",
+					    (unsigned long long)args.arg1,
+					    (unsigned long long)args.arg2,
+					    (unsigned long long)args.arg3);
+				}
+			}
+		}
+	}
+#endif
+
 	retval = mach_call(&args);
 
 skip_machcall:
@@ -289,6 +323,24 @@
 	    MACHDBG_CODE(DBG_MACH_EXCP_SC, (call_number)) | DBG_FUNC_END,
 	    retval, 0, 0, 0, 0);
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	{
+		extern struct proc *current_proc(void);
+		extern int proc_pid(struct proc *);
+		extern const char *proc_best_name(struct proc *);
+		struct proc *cp3 = current_proc();
+		const char *cnm3 = cp3 != NULL ? proc_best_name(cp3) : NULL;
+
+		if (cnm3 != NULL && cnm3[0] == 'x' && strcmp(cnm3, "xpcproxy") == 0) {
+			static int sweet_mt_done2 = 240;
+
+			if (sweet_mt_done2 > 0) {
+				sweet_mt_done2--;
+				printf("SWEET MTRAP xpcproxy n=%d ret %#x\n", call_number, retval);
+			}
+		}
+	}
+#endif
 	arm_set_mach_syscall_ret(state, retval);
 
 	throttle_lowpri_io(1);
