 static bool
 proc_should_trigger_panic(proc_t p, int rv)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * sweetnodaemonpanic=1: a daemon that exits (or crashes, or whose spawn
+	 * failed) must not take the machine down while the port is being brought up.
+	 * launchd itself still panics - a dead init is fatal by definition.
+	 */
+	{
+		int nodaemon = 0;
+
+		/*
+		 * Compare the NAME, not the initproc pointer: on this port initproc
+		 * matches ordinary daemons (a configd exit was reported as
+		 * "initproc failed to start"), so only a process really called
+		 * launchd may take the machine down.
+		 */
+		if (PE_parse_boot_argn("sweetnodaemonpanic", &nodaemon, sizeof(nodaemon)) && nodaemon &&
+		    strncmp(p->p_comm, "launchd", sizeof("launchd")) != 0) {
+			return false;
+		}
+	}
+#endif
 	if (p == initproc || (p->p_crash_behavior & POSIX_SPAWN_PANIC_ON_EXIT) != 0) {
 		/* Always panic for launchd or equivalents */
 		return true;
