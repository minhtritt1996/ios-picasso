+/* Trace lines belong in the ring only: printf () draws the framebuffer
+ * console, and a wedged framebuffer write while sweet_ufs_lock is held stops
+ * every later file I/O (bp25: the ring ended in the middle of a "SWEET UFS gd"
+ * line, i.e. the console write died inside it and took the boot with it). */
+void
+sweet_tracef(const char *fmt, ...) __printflike(1, 2);
+
+void
+sweet_tracef(const char *fmt, ...)
+{
+	char line[192];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	if (n > 0) {
+		sweet_log_append(line, MIN(n, (int)sizeof(line) - 1));
+	}
+}
