 public:
+	/* Wipe the early-boot console image once the console is muted, so the panel
+	 * shows only what userland draws. */
+	void
+	clearPanelOnce(void)
+	{
+		if (fPixels != 0 && fRowBytes != 0 && fHeight != 0) {
+			memset((void *)fPixels, 0, (size_t)fRowBytes * (size_t)fHeight);
+			IOLog("SWEET FB: panel cleared after console mute\n");
+		}
+	}
+
 	uint64_t      fPhys;
