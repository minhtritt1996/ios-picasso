+/* Userspace asks IOServiceMatching("SweetGPU") and gives up when it is absent (the
+ * CoreAnimation bridge only loads with a GPU service present). Publish a stub so the
+ * bridge loads; Mesa finds no usable hardware behind it and draws in software. */
+class SweetGPU : public IOService {
+	OSDeclareDefaultStructors(SweetGPU);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE
+	{
+		if (!IOService::start(provider)) {
+			return false;
+		}
+		setProperty("stub", true);
+		registerService();
+		return true;
+	}
+};
+
+OSDefineMetaClassAndStructors(SweetGPU, IOService);
+
