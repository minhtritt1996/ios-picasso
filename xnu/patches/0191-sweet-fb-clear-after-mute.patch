+static void
+sweet_fb_clear_thread(void *arg, wait_result_t wr __unused)
+{
+	AppleCLCD *self = (AppleCLCD *)arg;
+
+	for (int i = 0; i < 1200; i++) {          /* up to 120 s */
+		if (sweet_console_muted) {
+			IOSleep(200);              /* let the last console line land */
+			self->clearPanelOnce();
+			return;
+		}
+		IOSleep(100);
+	}
+}
