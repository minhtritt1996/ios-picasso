 /*
  * Find a GPT partition on any UFS LUN: on picasso "userdata" is on LUN 0
  * but "modem" is on LUN 4, and every LUN has its own GPT.
+ *
+ * Every answer is cached, misses included: the modem asks for "misc", "efs"
+ * and the modem partition again for every rmtfs request, and probing a LUN
+ * that has no device costs a SCSI timeout each time.  A lookup that is
+ * already the root partition costs nothing at all.
  */
+struct part_cache {
+	char name[24];
+	uint64_t first, nblocks;
+	uint32_t lun;
+	int error;
+};
+
+static struct part_cache part_cache[12];
+static unsigned part_cache_n;
+
 int
 sweet_ufs_part(const char *name, uint64_t *first, uint64_t *nblocks, uint32_t *lun)
 {
 	if (!su.ready) {
 		return ENXIO;
 	}
+	if (su.want[0] != 0 && strncmp(name, su.want, sizeof(su.want) - 1) == 0 &&
+	    su.nblocks != 0) {
+		*first = su.first_block;
+		*nblocks = su.nblocks;
+		*lun = su.lun;
+		return 0;
+	}
+	for (unsigned i = 0; i < part_cache_n; i++) {
+		if (strncmp(part_cache[i].name, name, sizeof(part_cache[i].name) - 1) != 0) {
+			continue;
+		}
+		if (part_cache[i].error == 0) {
+			*first = part_cache[i].first;
+			*nblocks = part_cache[i].nblocks;
+			*lun = part_cache[i].lun;
+		}
+		return part_cache[i].error;
+	}
+	/* The LUN that answered last time first: probing a LUN with no device
+	 * costs a command timeout, and every other thread wanting the disk waits
+	 * for the lock while it happens. */
+	uint32_t order[8];
+	uint32_t n = 0;
+	order[n++] = part_last_lun < 8 ? part_last_lun : 0;
 	for (uint32_t u = 0; u < 8; u++) {
-		uint64_t f, l;
+		if (u != order[0]) {
+			order[n++] = u;
+		}
+	}
+	int rc = ENOENT;
+	for (uint32_t i = 0; i < n; i++) {
+		uint64_t f = 0, l = 0, t0 = mach_absolute_time(), ns = 0;
 		int error;
 
+		su.part_lun = order[i];
+		su.part_step = 1;
 		ufs_lock(UFS_LK_PART);
-		error = ufs_gpt_entry_lun((uint8_t)u, name, &f, &l);
+		error = ufs_gpt_entry_lun((uint8_t)order[i], name, &f, &l);
 		ufs_unlock();
+		su.part_step = 0;
 		if (error == 0) {
 			*first = f;
 			*nblocks = l - f + 1;
-			*lun = u;
-			return 0;
+			*lun = order[i];
+			part_last_lun = order[i];
 		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		/* Logged outside the lock: a printf under it is how a boot stops. */
+		printf("SWEET UFS: part \"%s\" probe %u: LUN %u err %d, %llu ms\n",
+		    name, i, order[i], error, ns / 1000000ull);
+		if (error == 0) {
+			rc = 0;
+			break;
+		}
 	}
-	return ENOENT;
+	if (part_cache_n < sizeof(part_cache) / sizeof(part_cache[0])) {
+		struct part_cache *c = &part_cache[part_cache_n++];
+		strlcpy(c->name, name, sizeof(c->name));
+		c->error = rc;
+		if (rc == 0) {
+			c->first = *first;
+			c->nblocks = *nblocks;
+			c->lun = *lun;
+		}
+	}
+	return rc;
 }
 
