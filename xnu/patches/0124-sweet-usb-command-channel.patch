+extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t sweet_log_position(void);
+
+static int ud_probe_on = 1;      /* sweetusbprobe=0 stops the TX probe */
+/*
+ * Command channel: one text command per UDP datagram to 192.168.7.2:5141,
+ * answered by one datagram. This is the port's only direct control path, so
+ * keep it dependency-free: no VFS, no threads of its own.
+ */
+static void
+ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char buf[1500];
+	socket_t so = NULL;
+	struct sockaddr_in addr;
+
+	bzero(&addr, sizeof(addr));
+	addr.sin_len = sizeof(addr);
+	addr.sin_family = AF_INET;
+	addr.sin_port = htons(5141);
+	addr.sin_addr.s_addr = htonl(0xc0a80702);       /* 192.168.7.2 */
+	for (;;) {
+		ud_sleep_ms(200);
+		if (!ud.configured) {
+			continue;
+		}
+		if (so == NULL) {
+			if (sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+				so = NULL;
+				continue;
+			}
+			if (sock_bind(so, (struct sockaddr *)&addr) != 0) {
+				sock_close(so);
+				so = NULL;
+				continue;
+			}
+			printf("SWEET USB: command channel on 192.168.7.2:5141\n");
+		}
+		struct sockaddr_in from;
+		struct iovec iov = { .iov_base = buf, .iov_len = sizeof(buf) - 1 };
+		struct msghdr msg = {
+			.msg_name = &from, .msg_namelen = sizeof(from),
+			.msg_iov = &iov, .msg_iovlen = 1,
+		};
+		size_t got = 0;
+		if (sock_receive(so, &msg, MSG_DONTWAIT, &got) != 0 || got == 0) {
+			continue;
+		}
+		buf[got] = 0;
+		char *nl = strchr(buf, '\n');
+		if (nl != NULL) {
+			*nl = 0;
+		}
+		if (msg.msg_namelen == 0) {
+			bzero(&from, sizeof(from));
+			from.sin_len = sizeof(from);
+			from.sin_family = AF_INET;
+			from.sin_port = htons(5141);
+			from.sin_addr.s_addr = htonl(0xc0a80701);
+			msg.msg_name = &from;
+			msg.msg_namelen = sizeof(from);
+		}
+		if (strcmp(buf, "log") == 0) {
+			uint64_t pos = sweet_log_position();
+			pos = pos > 1300 ? pos - 1300 : 0;
+			memset(buf, 0, sizeof(buf));
+			sweet_log_copy(&pos, buf, 1300);
+			iov.iov_len = strlen(buf);
+		} else if (strcmp(buf, "info") == 0) {
+			iov.iov_len = (size_t)snprintf(buf, sizeof(buf),
+			    "configured %d rx frames %llu tx frames %llu calls %u drops %u "
+			    "probe %u busy %d\n", (int)ud.configured,
+			    ud.rx_frames, ud.tx_frames, ud.tx_calls, ud.tx_drops,
+			    ud.probes, (int)ud.tx_busy);
+		} else if (strncmp(buf, "probe ", 6) == 0) {
+			ud_probe_on = (buf[6] != '0');
+			iov.iov_len = (size_t)snprintf(buf, sizeof(buf), "probe %d\n", ud_probe_on);
+		} else if (strcmp(buf, "reboot") == 0) {
+			iov.iov_len = (size_t)snprintf(buf, sizeof(buf), "rebooting\n");
+			size_t sent = 0;
+			sock_send(so, &msg, 0, &sent);
+			ud_sleep_ms(200);
+			printf("SWEET USB: reboot requested over the command channel\n");
+			reboot_kernel(RB_AUTOBOOT, NULL);
+			continue;
+		} else {
+			iov.iov_len = (size_t)snprintf(buf, sizeof(buf),
+			    "commands: log | info | probe 0|1 | reboot\n");
+		}
+		size_t sent = 0;
+		sock_send(so, &msg, 0, &sent);
+	}
+}
