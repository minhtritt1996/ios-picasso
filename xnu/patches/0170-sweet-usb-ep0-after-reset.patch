+/*
+ * Rebuild endpoint 0 after a bus reset. The core wipes the endpoint configuration on a
+ * reset; the host then re-enumerates, and if ep0 is not working again its
+ * SET_CONFIGURATION never arrives - the ring showed two resets, "configuration dropped"
+ * twice, and no SET_CONFIGURATION after them, which leaves cfg 0 and the IP path dead
+ * while the control channel keeps working. Same sequence as bring-up.
+ */
+static uint32_t ud_ep0_mps = 64;      /* set during bring-up, reused by the reset path */
+
+static bool
+ud_ep0_restart(uint32_t ep0_mps)
+{
+	int e0 = ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0);
+	int e1 = e0 || ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (ep0_mps << 3),
+	    (1u << 8) | (1u << 10) | (0u << 25), 0);
+	int e2 = e1 || ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0);
+	int e3 = e2 || ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (ep0_mps << 3),
+	    (1u << 8) | (1u << 10) | (1u << 25), 0);
+	int e4 = e3 || ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0);
+
+	if (e0 || e1 || e2 || e3 || e4) {
+		return false;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | 0x3);
+	ud_start_setup();
+	return true;
+}
