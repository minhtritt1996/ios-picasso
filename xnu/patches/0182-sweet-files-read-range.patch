+/* RAWBLK <start_block> <nblocks>: write nblocks*4096 bytes straight to the root
+ * device. Nothing in the catalog changes, so this is the safe way to replace a
+ * file of the SAME size without a recovery round trip (the VFS create path
+ * wedges on this port). */
+extern int sweet_ufs_write_blocks_raw(uint64_t lba, uint32_t count, const void *src);
+
+/* RAWBLK <start_block> <nblocks>: write nblocks*4096 bytes straight to the root
+ * device through the UFS driver (the VFS path wedges on this port). Nothing in
+ * the catalog changes, so this is only for same-size replacements. */
+static int sweet_rawblk_prints = 8;
+
+static int
+sf_rawblk(socket_t so, uint64_t blk, uint64_t cnt)
+{
+	uint64_t left = cnt * 4096ULL;
+	uint64_t off = blk;
+
+	while (left != 0) {
+		size_t chunk = (size_t)MIN((uint64_t)SF_BUF, left);
+		int err = sf_recv_all(so, sf_buf, chunk);
+
+		if (err != 0) {
+			return err;
+		}
+		if (sweet_rawblk_prints > 0) {
+			sweet_rawblk_prints--;
+			printf("SWEET FILES: RAWBLK %llu+%u\n", off, (unsigned)(chunk / 4096));
+		}
+		err = sweet_ufs_write_blocks_raw(off, (uint32_t)(chunk / 4096), sf_buf);
+		if (err != 0) {
+			return err;
+		}
+		off += chunk / 4096;
+		left -= chunk;
+	}
+	return 0;
+}
