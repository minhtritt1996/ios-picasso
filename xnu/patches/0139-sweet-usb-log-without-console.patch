+/*
+ * Console output from this driver must not depend on the console: the fb
+ * console and the printf lock have both been seen to stop for good (the screen
+ * froze at 12 s while the kernel kept running), and a thread that prints while
+ * that happens never comes back - which is how the USB event thread died. Write
+ * straight into the lock-free console ring instead.
+ */
+extern void sweet_log_append(const char *c, int size);
+
+static void
+ud_log(const char *fmt, ...)
+{
+	char buf[512];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	if (n > 0) {
+		sweet_log_append(buf, MIN(n, (int)sizeof(buf) - 1));
+	}
+}
