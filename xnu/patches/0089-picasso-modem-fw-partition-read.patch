+/*
+ * SWEET: read a GPT partition other than the root one, for the modem
+ * firmware on "modem" (iokit/Kernel/arm/PicassoModem.cpp). Lookup does not
+ * disturb su.first_block; reads share the bounce buffer and the lock.
+ */
+int sweet_ufs_part(const char *name, uint64_t *first, uint64_t *nblocks, uint32_t *lun);
+int sweet_ufs_pread(uint32_t lun, uint64_t first, uint64_t nblocks, uint64_t off, void *dst,
+    uint32_t len);
+int sweet_ufs_pwrite(uint32_t lun, uint64_t first, uint64_t nblocks, uint64_t off,
+    const void *src, uint32_t len);
+
+/*
+ * Find a GPT partition on any UFS LUN: on picasso "userdata" is on LUN 0
+ * but "modem" is on LUN 4, and every LUN has its own GPT.
+ */
+int
+sweet_ufs_part(const char *name, uint64_t *first, uint64_t *nblocks, uint32_t *lun)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	for (uint32_t u = 0; u < 8; u++) {
+		uint64_t f, l;
+		int error;
+
+		lck_mtx_lock(&sweet_ufs_lock);
+		error = ufs_gpt_entry_lun((uint8_t)u, name, &f, &l);
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (error == 0) {
+			*first = f;
+			*nblocks = l - f + 1;
+			*lun = u;
+			return 0;
+		}
+	}
+	return ENOENT;
+}
+
+/*
+ * SWEET: write into a GPT partition other than the root one (the modem
+ * driver writes the Android BCB into "misc" to make the next boot enter
+ * recovery). Needs the device opened read-write (boot-arg ufsrw=1).
+ */
+int
+sweet_ufs_pwrite(uint32_t lun, uint64_t first, uint64_t nblocks, uint64_t off,
+    const void *src, uint32_t len)
+{
+	char *b = (char *)(su.dma + DMA_BOUNCE);
+	uint8_t saved;
+	int error = 0;
+
+	if (!su.ready) {
+		return ENXIO;
+	}
+	if (!su.writable) {
+		return EROFS;
+	}
+	if (nblocks == 0 || off / UFS_BLOCK >= nblocks || len > nblocks * UFS_BLOCK - off) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	saved = su.lun;
+	su.lun = (uint8_t)lun;
+	while (len && !error) {
+		uint64_t lba = off / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(off % UFS_BLOCK);
+		uint32_t want = MIN(len, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+
+		if (skip) {
+			/* read-modify-write the partial first block */
+			error = ufs_read_blocks(first + lba, blocks);
+			if (error) {
+				break;
+			}
+		}
+		memcpy(b + skip, src, want);
+		error = ufs_write_blocks_at(first + lba, blocks);
+		if (error) {
+			break;
+		}
+		src = (const char *)src + want;
+		off += want;
+		len -= want;
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	su.lun = saved;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
+
+int
+sweet_ufs_pread(uint32_t lun, uint64_t first, uint64_t nblocks, uint64_t off, void *dst,
+    uint32_t len)
+{
+	const char *b = (const char *)(su.dma + DMA_BOUNCE);
+	uint8_t saved;
+	int error = 0;
+
+	if (!su.ready) {
+		return ENXIO;
+	}
+	if (nblocks == 0 || off / UFS_BLOCK >= nblocks || len > nblocks * UFS_BLOCK - off) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	saved = su.lun;
+	su.lun = (uint8_t)lun;
+	while (len && !error) {
+		uint64_t lba = off / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(off % UFS_BLOCK);
+		uint32_t want = MIN(len, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		error = ufs_read_blocks(first + lba, blocks);
+		if (error) {
+			break;
+		}
+		memcpy(dst, b + skip, want);
+		dst = (char *)dst + want;
+		off += want;
+		len -= want;
+	}
+	su.lun = saved;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
