 static int
+ufs_gpt_entry(const char *want, uint64_t *first_out, uint64_t *last_out)
+{
+	return ufs_gpt_entry_lun(su.lun, want, first_out, last_out);
+}
+
+static int
+ufs_find_partition(const char *want)
+{
+	uint64_t first, last;
+	int error = ufs_gpt_entry(want, &first, &last);
+	if (error == ENOENT) {
+		printf("SWEET UFS: no GPT partition named \"%s\"\n", want);
+	}
+	if (error) {
+		return error;
+	}
+	su.first_block = first;
+	su.nblocks = last - first + 1;
+	return 0;
+}
