+/* WRITE(10) of count device blocks from the bounce buffer, any partition. */
+static int
+ufs_write_blocks_at(uint64_t lba, uint32_t count)
+{
+	if (count == 0 || count > BOUNCE_SIZE / UFS_BLOCK || lba > UINT32_MAX ||
+	    lba + count - 1 > UINT32_MAX) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
