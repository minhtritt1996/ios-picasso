+/* Breadcrumbs: which request is in flight and in which step, so a watchdog can
+ * say where the single-threaded server blocks when userland I/O stops moving. */
+static volatile uint32_t fs_serial;
+static volatile uint32_t fs_step;
+static volatile uint64_t fs_t0;
+static char fs_what[96];
+
+static void
+sf_mark(uint32_t step, const char *fmt, ...)
+{
+	va_list ap;
+	int n;
+	fs_step = step;
+	fs_t0 = mach_absolute_time();
+	va_start(ap, fmt);
+	n = vsnprintf(fs_what, sizeof(fs_what), fmt, ap);
+	va_end(ap);
+	if (n < 0) {
+		fs_what[0] = 0;
+	}
+}
+
 static void
