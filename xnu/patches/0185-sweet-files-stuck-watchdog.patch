+static void
+sf_watchdog(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t last = 0;
+	uint32_t last_serial = 0;
+	for (;;) {
+		sf_sleep_ms(2000);
+		uint64_t now = mach_absolute_time(), age_ns = 0;
+		uint32_t step = fs_step;
+		if (step == 0) {
+			continue;
+		}
+		absolutetime_to_nanoseconds(now - fs_t0, &age_ns);
+		if (age_ns < 5000000000ull) {
+			continue;
+		}
+		if (now - last < 10000000000ull && fs_serial == last_serial) {
+			continue;
+		}
+		last = now;
+		last_serial = fs_serial;
+		printf("SWEET FILES STUCK: serial %u step %u age %llu ms: %s\n",
+		    (unsigned)fs_serial, (unsigned)step,
+		    (unsigned long long)(age_ns / 1000000ull), fs_what);
+	}
+}
