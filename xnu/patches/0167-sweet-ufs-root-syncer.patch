--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -24,6 +24,7 @@
 #include <sys/buf.h>
 #include <sys/conf.h>
 #include <sys/disk.h>
+#include <sys/mount.h>
 #include <sys/errno.h>
 #include <sys/proc.h>
 #include <sys/uio.h>
@@ -1756,6 +1757,52 @@
  */
 static int sweet_hb_console = 1;
 
+/*
+ * sys/mount.h gives vfs_flags/VFS_SYNC/vfs_iterate; vfs_context_kernel() is declared in
+ * sys/vfs_context.h, which this file does not include and which the kernel build's
+ * include order does not pull in either, so say it here.
+ */
+extern vfs_context_t vfs_context_kernel(void);
+
+/*
+ * The root here is a non-journaled HFS+ volume and it is the root, so HFS never starts
+ * its own syncer (HFS_RUN_SYNCER is for ejectable media) and dirty file pages just sit
+ * in the UBC until something forces a sync. When that finally happens the flush is
+ * large, the UFS path wedges and the boot stalls - which is what the ~90 s hang in the
+ * daemon phase looks like. Bergamota closes the same window with a thread that syncs
+ * every ufssyncsecs (patch 0222, 5 s); this is the minimal version: a VFS_SYNC of every
+ * writable mount.
+ */
+static int sweet_sync_chan;
+
+static int
+sweet_sync_mount(mount_t mp, __unused void *arg)
+{
+	if (!(vfs_flags(mp) & MNT_RDONLY)) {
+		(void)VFS_SYNC(mp, MNT_WAIT, vfs_context_kernel());
+	}
+	return VFS_RETURNED;
+}
+
+static void
+sweet_ufs_syncer(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		(void)tsleep(&sweet_sync_chan, PZERO, "sweetsync", hz * 5);
+		(void)vfs_iterate(LK_NOWAIT, sweet_sync_mount, NULL);
+	}
+}
+
+static void
+sweet_ufs_syncer_start(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(sweet_ufs_syncer, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 static void
 sweet_ufs_watchdog(__unused void *arg, __unused wait_result_t wr)
 {
@@ -1927,6 +1974,7 @@
 {
 	thread_t thread;
 
+	sweet_ufs_syncer_start();
 	if (kernel_thread_start(sweet_ufs_watchdog, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
