 /*
+ * READ(10) straight into dst (a page-aligned kernel buffer), skipping the
+ * copy out of the bounce buffer.  bp17 stopped inside that copy for a
+ * minute with the UFS lock held (272 KiB, "ss 3", no command outstanding),
+ * and the boot never got past the dyld cache read; the engine writing DRAM
+ * itself does not go through the CPU's view of the destination at all.
+ * Returns EINVAL when a page is not mapped, so the caller can fall back.
+ */
+static int
+ufs_read_blocks_dma(uint64_t lba, uint32_t count, void *dst)
+{
+	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	su.cmd_lba = lba; su.cmd_count = count; su.cmd_op = 0x28; su.cmd_lun = su.lun;
+	su.cmd_serial++;
+	su.cmd_start = mach_absolute_time();
+	uint8_t cdb[10] = {
+		0x28, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	int error = ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, false, dst);
+	su.cmd_start = 0;
+	if (error) {
+		su.last_err = error;
+		su.err_serial++;
+	}
+	return error;
+}
