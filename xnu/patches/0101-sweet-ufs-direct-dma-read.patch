+/*
+ * Cache maintenance for a transfer buffer that is ordinary kernel memory
+ * (see ufs_read_blocks_dma), by physical address, page by page.
+ */
+static void
+ufs_dma_sync_buf(const void *buf, uint32_t len, bool write)
+{
+	uint32_t done = 0;
+
+	while (done < len) {
+		addr64_t va = (addr64_t)(uintptr_t)((const char *)buf + done);
+		uint32_t chunk = MIN(len - done, (uint32_t)(PAGE_SIZE - (va & PAGE_MASK)));
+		ppnum_t pn = pmap_find_phys(kernel_pmap, va);
+
+		if (pn == 0) {
+			return;
+		}
+		if (write) {
+			clean_dcache64(ptoa_64(pn) + (va & PAGE_MASK), chunk, TRUE);
+		} else {
+			flush_dcache64(ptoa_64(pn) + (va & PAGE_MASK), chunk, TRUE);
+		}
+		done += chunk;
+	}
+}
