+/* Set the final size of a file written with `put`, then flush its data. */
+static int
+ud_putend(const char *path, off_t size, char *out, size_t outsz)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct vnode_attr va;
+	vnode_t vp = NULL;
+	int err = vnode_open(path, O_RDWR, 0, 0, &vp, ctx);
+
 	if (err != 0) {
-		snprintf(out, outsz, "%s: error %d at off %lld\n", path, err, off);
+		snprintf(out, outsz, "%s: open error %d\n", path, err);
+		return err;
+	}
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_data_size, size);
+	err = vnode_setattr(vp, &va, ctx);
+	if (err == 0) {
+		err = VNOP_FSYNC(vp, MNT_WAIT, ctx);
 	}
+	vnode_close(vp, FWRITE, ctx);
+	snprintf(out, outsz, "%s: size %lld %s\n", path, size,
+	    err == 0 ? "set" : "error");
 	return err;
 }
 
