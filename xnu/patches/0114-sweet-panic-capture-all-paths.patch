 /*
+ * Called from panic_spin_forever(): debugger_panic_str is still valid and is
+ * the only place the reason string exists on this board.  Put it at the head
+ * of the text, then flush.
+ */
+void
+sweet_panic_report(const char *s)
+{
+	char line[256];
+	int n;
+
+	if (s == NULL || s[0] == '\0') {
+		return;
+	}
+	n = snprintf(line, sizeof(line), "\nSWEET PANIC: %s\n", s);
+	if (n > 0) {
+		sweet_log_append(line, MIN(n, (int)sizeof(line) - 1));
+	}
+	(void)sweet_ufs_panic_dump();
+}
+
+/*
+ * The panic report is printed with _doprnt(debugger_panic_str, ...,
+ * consdebug_putc), which never reaches _cnputs(): capture it here, one char at
+ * a time, and flush the ring at the end of each line.  Only active once
+ * debugger_panic_str is set, so a normal boot pays one compare per char.
+ */
+void
+sweet_panic_putc(char c)
+{
+	extern const char *debugger_panic_str;  /* osfmk/kern/debug.c */
+	static uint64_t last_dump;
+
+	if (debugger_panic_str == NULL) {
+		return;
+	}
+	sweet_log_append(&c, 1);
+	if (c == '\n') {
+		uint64_t now = mach_absolute_time(), ns = 0;
+		if (last_dump != 0) {
+			absolutetime_to_nanoseconds(now - last_dump, &ns);
+		}
+		if (last_dump == 0 || ns > 200ull * NSEC_PER_MSEC) {
+			last_dump = now;
+			(void)sweet_ufs_panic_dump();
+		}
+	}
+}
