sweet ufs: make the copy out of the bounce buffer visible

bp17 sat with "lk 4/1 ... age 0 ms ... ss 3 ... sc 278528" for a minute:
the strategy path had the UFS lock, no command outstanding, and it was
between the read and the copy out of a 272 KiB buffer - so the memcpy to
the buffer's kernel address is where the boot stops, not the controller.

Copy in 4 KiB steps and publish the cursor, plus the destination address
and the time spent inside the block, and print them in the heartbeat.  A
frozen cursor is a store that never returns; a moving one with an
absurdly small rate says the destination mapping is the problem, and
both name the fix (map the buffer normally, or hand the buffer address
to the DMA engine and skip the copy).
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -140,6 +140,9 @@
 	 * with owner 4 and no command outstanding is stuck in memcpy or in the
 	 * unlock.  Printed by the heartbeat. */
 	volatile uint32_t strat_step;
+	volatile uint64_t strat_vaddr;
+	volatile uint32_t strat_done;
+	volatile uint64_t strat_t0;
 	volatile uint64_t strat_blk;
 	volatile uint32_t strat_count;
 	volatile uint32_t strat_tid;
@@ -423,6 +426,23 @@
 	return ufs_scsi(cdb, sizeof(cdb), 0, false);
 }
 
+/*
+ * Copy with a visible cursor.  bp17 wedged with the strategy path stuck
+ * between the read and the copy out ("ss 3") for a minute, on a 272 KiB
+ * buffer, while its thread id and buf block number stayed readable: the
+ * heartbeat prints strat_done, so a boot shows whether the copy is moving
+ * and, if it is, how many bytes per second.
+ */
+static void
+ufs_copy_out(void *dst, const void *src, uint32_t len, volatile uint32_t *prog)
+{
+	for (uint32_t i = 0; i < len; i += 4096) {
+		uint32_t n = MIN(4096u, len - i);
+		memcpy((char *)dst + i, (const char *)src + i, n);
+		*prog = i + n;
+	}
+}
