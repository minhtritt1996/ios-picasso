+/*
+ * Heartbeat: one console line every two seconds, no UFS traffic at all.  If
+ * these lines stop the scheduler itself died; if they keep coming while the
+ * persistent log does not, the flusher is blocked, and the line shows what the
+ * UFS layer is doing and how long the outstanding command has been running.
+ */
+static int sweet_hb_chan;
+
+static void
+sweet_ufs_watchdog(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t tick = 0;
+
+	for (;;) {
+		(void)tsleep(&sweet_hb_chan, PZERO, "sweethb", hz * 2);
+		uint64_t start = su.cmd_start, age_ms = 0;
+		if (start) {
+			uint64_t now = mach_absolute_time();
+			if (now > start) {
+				uint64_t ns = 0;
+				absolutetime_to_nanoseconds(now - start, &ns);
+				age_ms = ns / 1000000ull;
+			}
+		}
+		char line[192];
+		int n = snprintf(line, sizeof(line),
+		    "SWEET HB %u: log %u seq %u beats %u | cmd %u lba 0x%llx n %u lun %u op 0x%02x"
+		    " age %u ms | err %d x%u\n",
+		    ++tick, (unsigned)os_atomic_load(&sweet_log_total, relaxed),
+		    sweet_log_seq_g, (unsigned)sweet_log_beats,
+		    (unsigned)su.cmd_serial, (unsigned long long)su.cmd_lba,
+		    (unsigned)su.cmd_count, (unsigned)su.cmd_lun, (unsigned)su.cmd_op,
+		    (unsigned)age_ms, su.last_err, (unsigned)su.err_serial);
+		if (n > 0) {
+			/* Ring first: printf() can block in the framebuffer driver, and
+			 * then the ring is the only channel that still records progress.
+			 * The console hook appends the same text again; a duplicated
+			 * heartbeat line is cheaper than a lost one. */
+			sweet_log_append(line, MIN(n, (int)sizeof(line) - 1));
+			printf("%s", line);
+		}
+	}
+}
+
+static void
+sweet_ufs_watchdog_start(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(sweet_ufs_watchdog, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
