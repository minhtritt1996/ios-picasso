  * One SCSI command in slot 0, data (if any) to/from the bounce buffer
  * (to the device when write is set). Returns 0 or an errno.
  */
+/*
+ * Every command on a LUN other than the root one is written straight into the
+ * ring, before it is issued: those are the modem's firmware reads, they run
+ * once, and if one of them wedges the controller this line is the only record
+ * of which LBA was in flight.
+ */
+static void
+ufs_trace(void)
+{
+	char line[96];
+	int n;
+
+	if (su.cmd_lun == 0) {
+		return;
+	}
+	n = snprintf(line, sizeof(line), "SWEET CMD %u: lun %u op 0x%02x lba 0x%llx n %u\n",
+	    (unsigned)su.cmd_serial, (unsigned)su.cmd_lun, (unsigned)su.cmd_op,
+	    (unsigned long long)su.cmd_lba, (unsigned)su.cmd_count);
+	if (n > 0) {
+		sweet_log_append(line, MIN(n, (int)sizeof(line) - 1));
+	}
+}
