+
+/*
+ * Raw driver state for the kick thread, which keeps running when the USB event
+ * thread stops: reading it from there is the only way to see what the endpoint
+ * ownership flags actually say at the moment the link goes quiet.
+ */
+void
+sweet_usb_state(char *out, int outlen)
+{
+	volatile uint32_t *rx = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	volatile uint32_t *tx = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
+
+	if (ud.dma == 0) {
+		snprintf(out, outlen, " usb=notstarted\n");
+		return;
+	}
+	snprintf(out, outlen,
+	    " usb cfg %d rxarm %d txbusy %d evq 0x%x dalepa 0x%x hwo %d/%d"
+	    " rx %llu tx %llu lost %u/%u stale %u/%u sp %u/%u err %u q %u\n",
+	    (int)ud.configured, (int)ud.rx_armed, (int)ud.tx_busy,
+	    dwc_rd(GEVNTCOUNT) & 0xffff, dwc_rd(DALEPENA),
+	    (rx[3] & TRB_HWO) ? 1 : 0, (tx[3] & TRB_HWO) ? 1 : 0,
+	    ud.rx_frames, ud.tx_frames, ud.rx_lost, ud.tx_lost,
+	    ud.rx_stale, ud.tx_stale, ud.rx_spurious, ud.tx_spurious,
+	    ud.rx_arm_err, ud.txq_count);
+}
