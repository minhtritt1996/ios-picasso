+	uint32_t holder_step = su.strat_step, holder_flush = su.flush_stage;
+	uint64_t holder_blk = su.strat_blk, holder_cnt = su.strat_count;
 	lck_mtx_lock(&sweet_ufs_lock);
+	uint64_t waited_ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &waited_ns);
+	if (waited_ns > 200000000ull) {
+		sweet_tracef("SWEET UFS LKWAIT tid %u who %u waited %llu ms; holder owner %u tid %u"
+		    " step %u flush %u blk 0x%llx c %llu\n", (unsigned)thread_tid(current_thread()),
+		    (unsigned)who, (unsigned long long)(waited_ns / 1000000ull),
+		    (unsigned)holder_owner, (unsigned)holder_tid, (unsigned)holder_step,
+		    (unsigned)holder_flush, (unsigned long long)holder_blk,
+		    (unsigned long long)holder_cnt);
+	}
 	su.lock_owner = who;
 	su.lock_users++;
 	su.lock_tid = (uint32_t)thread_tid(current_thread());
