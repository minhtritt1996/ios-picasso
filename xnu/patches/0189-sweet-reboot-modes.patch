+
+/*
+ * Reboot with a mode, the Qualcomm way: the mode goes into the IMEM
+ * restart_reason word (lito: 0x146ab65c) and into the PMIC PON spare byte that
+ * ABL reads, then PS_HOLD (lito: 0xc264000) is driven low, which resets the SoC.
+ * Values are the ones aboot/ABL use: 0x77665500 bootloader, 0x77665502 recovery.
+ */
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value);
+extern int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+
+#define SWEET_IMEM_PA        0x146ab000ull
+#define SWEET_IMEM_REASON    0x65c
+#define SWEET_PSHOLD_PA      0xc264000ull
+#define SWEET_PON_SPARE      0x88f
+
+static char sweet_reboot_mode_buf[16] = "normal";
+
+static uint32_t
+sweet_reboot_imem_value(void)
+{
+	if (!strcmp(sweet_reboot_mode_buf, "bootloader")) {
+		return 0x77665500;
+	}
+	if (!strcmp(sweet_reboot_mode_buf, "recovery")) {
+		return 0x77665502;
+	}
+	return 0;
+}
+
+static uint8_t
+sweet_reboot_pon_value(void)
+{
+	if (!strcmp(sweet_reboot_mode_buf, "bootloader")) {
+		return 2;               /* pm8998/pm7250 mode-bootloader */
+	}
+	if (!strcmp(sweet_reboot_mode_buf, "recovery")) {
+		return 1;               /* mode-recovery */
+	}
+	return 0;
+}
+
+static uint32_t
+sweet_reboot_write_reason(int *pon_err, uint8_t *pon_read)
+{
+	vm_offset_t imem = ml_io_map(SWEET_IMEM_PA, 0x1000);
+	uint32_t value = sweet_reboot_imem_value();
+
+	*pon_err = -1;
+	*pon_read = 0;
+	if (imem != 0) {
+		*(volatile uint32_t *)(imem + SWEET_IMEM_REASON) = value;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	/* PON spare byte: bits 7:1 are the reason field (Linux qcom-pon). */
+	{
+		uint8_t old = 0;
+
+		if (sweet_spmi_write(0, (SWEET_PON_SPARE - 1), sweet_reboot_pon_value()) == 0) {
+			*pon_err = 0;
+		}
+		if (sweet_spmi_read(0, SWEET_PON_SPARE, &old) == 0) {
+			*pon_read = old;
+		}
+	}
+	return value;
+}
+
 static void
+sweet_reboot_now(char *out, size_t max)
+{
+	int pon_err = -1;
+	uint8_t pon_read = 0;
+	uint32_t value = sweet_reboot_write_reason(&pon_err, &pon_read);
+
+	printf("SWEET REBOOT: mode %s imem 0x%08x pon %s (read 0x%02x)\n",
+	    sweet_reboot_mode_buf, value, pon_err == 0 ? "written" : "REFUSED", pon_read);
+	snprintf(out, max, "rebooting %s imem 0x%08x pon %d\n", sweet_reboot_mode_buf,
+	    value, pon_err);
+	__asm__ volatile("dsb sy" ::: "memory");
+	{
+		vm_offset_t psh = ml_io_map(SWEET_PSHOLD_PA, 0x1000);
+
+		if (psh != 0) {
+			*(volatile uint32_t *)psh = 0;      /* PS_HOLD low -> reset */
+		}
+	}
+	for (volatile int i = 0; i < 200000000; i++) {
+		/* if PS_HOLD did not take effect, keep the CPU busy until the watchdog */
+	}
+}
+
