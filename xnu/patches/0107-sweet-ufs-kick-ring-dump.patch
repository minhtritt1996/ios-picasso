--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1587,7 +1587,8 @@
 static void
 sweet_ufs_kick(__unused void *arg, __unused wait_result_t wr)
 {
-	uint32_t n = 0;
+	uint32_t n = 0, dump_every = 0;
+	uint64_t last_dump = 0;
 
 	extern void IODelay(unsigned int);
 
@@ -1621,6 +1622,20 @@
 			sweet_log_append(line, MIN(len, (int)sizeof(line) - 1));
 		}
 		sweet_kick_n++;
+		/* Every ten spins (~20 s) put the ring on the partition, without the
+		 * driver lock and without any timeout sleep: this thread keeps
+		 * running when the console write path, the flusher and every
+		 * tsleep/IOSleep in the kernel are stuck (bp26/bp27 froze before the
+		 * hang watchdog could fire, so nothing else writes the log). */
+		if (++dump_every >= 10) {
+			dump_every = 0;
+			if (os_atomic_load(&sweet_log_total, relaxed) != last_dump) {
+				int de = sweet_ufs_emergency_dump();
+				if (de == 0) {
+					last_dump = os_atomic_load(&sweet_log_total, relaxed);
+				}
+			}
+		}
 	}
 }
 
