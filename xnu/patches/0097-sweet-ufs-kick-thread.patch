+/*
+ * Ring-only progress line.  The heartbeat prints too, so a wedged framebuffer
+ * console stops it while the kernel is perfectly alive; this thread appends
+ * the same state to the ring and never touches the console, so a boot that
+ * "stops" still leaves a trace of which counter froze.
+ */
 static void
+sweet_ufs_kick(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t n = 0;
+
+	for (;;) {
+		char line[192];
+		uint64_t ns = 0, age = 0, last;
+		int len;
+
+		(void)tsleep(&sweet_hb_chan, PZERO, "sweetkick", hz * 2);
+		last = sweet_log_last_g;
+		if (last != 0 && mach_absolute_time() > last) {
+			absolutetime_to_nanoseconds(mach_absolute_time() - last, &ns);
+			age = ns / 1000000ull;
+		}
+		len = snprintf(line, sizeof(line),
+		    "SWEET KICK %u: log %u seq %u beats %u fails %u ferr %d fage %llu"
+		    " | cmd %u err %d x%u lk %u/%u st %u pp %u/%u\n",
+		    ++n, (unsigned)os_atomic_load(&sweet_log_total, relaxed),
+		    sweet_log_seq_g, (unsigned)sweet_log_beats, sweet_log_fails_g,
+		    sweet_log_ferr_g, (unsigned long long)age,
+		    (unsigned)su.cmd_serial, su.last_err, (unsigned)su.err_serial,
+		    (unsigned)su.lock_owner, (unsigned)su.lock_users,
+		    (unsigned)su.flush_stage, (unsigned)su.part_lun, (unsigned)su.part_step);
+		if (len > 0) {
+			sweet_log_append(line, MIN(len, (int)sizeof(line) - 1));
+		}
+	}
+}
+
+static void
 sweet_ufs_watchdog_start(void)
 {
 	thread_t thread;
@@ -1258,6 +1310,9 @@
 	if (kernel_thread_start(sweet_ufs_watchdog, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
+	if (kernel_thread_start(sweet_ufs_kick, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 }
 
