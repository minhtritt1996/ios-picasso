+
+/*
+ * Called from the kick thread in sweet_ufs.c, the one context that keeps running
+ * when the USB event thread stops.
+ *
+ * The raw state proved the failure: GEVNTCOUNT sits at 0xc forever while both
+ * TRB HWO bits read 0 and the endpoint is still enabled - pending events nobody
+ * consumes, because the consumer thread is gone. The ring itself is a DMA buffer
+ * and the dispatch code touches no sleeping lock, so this thread can finish the
+ * job: dispatch the pending events itself. It only does so after the pending
+ * count failed to change across two samples (~2 s), so it never races a live
+ * event thread.
+ */
+void
+sweet_usb_watchdog(void)
+{
+	static uint32_t seen;
+	static uint32_t stuck;
+	uint32_t count;
+
+	if (ud.dma == 0 || !ud.configured) {
+		seen = 0;
+		stuck = 0;
+		return;
+	}
+	count = dwc_rd(GEVNTCOUNT) & 0xffff;
+	if (count == 0) {
+		seen = 0;
+		stuck = 0;
+		return;
+	}
+	if (count != seen) {
+		seen = count;
+		stuck = 0;
+		return;
+	}
+	if (++stuck < 2) {
+		return;
+	}
+	stuck = 0;
+	seen = 0;
+	ud_log("SWEET USB: watchdog drains stuck ring, count 0x%x evtick %u\n",
+	    count, ud.ev_ticks);
+	ud_sync(UD_EVT, UD_EVT_SIZE);
+	for (uint32_t done = 0; done < count; done += 4) {
+		uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+		uint32_t peek = *(volatile uint32_t *)(ud.dma + UD_EVT +
+		    ((ud.evt_pos + 4) % UD_EVT_SIZE));
+
+		ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+		if (ev != 0) {
+			ud_event(ev, peek);
+		}
+	}
+	dwc_wr(GEVNTCOUNT, count);
+	/* The TRB the dead thread never re-armed: HWO clear means we own it. */
+	{
+		volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+
+		ud_sync(UD_TRB_RX, 16);
+		if (!(t[3] & TRB_HWO)) {
+			ud.rx_armed = false;
+			ud_rx_arm();
+		}
+	}
+}
