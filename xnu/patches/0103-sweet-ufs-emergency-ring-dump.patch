 	volatile uint32_t strat_count;
 	volatile uint32_t strat_tid;
+	volatile uint32_t emergency_dumps;       /* ring written without the lock */
+	volatile int32_t emergency_error;
 	volatile uint64_t poll_iters;           /* turns of the completion poll */
 	volatile uint32_t host_resets;          /* stalled commands recovered */
 	volatile uint32_t direct_reads;         /* reads that skipped the bounce copy */
@@ -1258,6 +1260,70 @@
 	uint64_t total, seq;
 };
 
+/*
+ * Dump the log ring to the partition WITHOUT taking the driver lock.  Called
+ * from an independent watchdog thread when the strategy path has held the
+ * lock for tens of seconds: at that point the holder published its command
+ * long ago, so no transfer can be in flight, and the alternative is losing
+ * the very lines that explain the stall (bp19 showed a wedge that also took
+ * the console with it - `sweetfb_noconsole` pauses it when the GUI appears).
+ * The bounce buffer is shared with the stuck thread on purpose: that thread
+ * is not coming back.
+ */
+int
+sweet_ufs_emergency_dump(void)
+{
+	uint64_t base, total, pos;
+	void *bounce;
+	int error = 0;
+
+	if (!su.ready || !su.writable || su.nblocks == 0 || su.first_block == 0) {
+		return ENXIO;
+	}
+	if (su.cmd_start) {
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - su.cmd_start, &ns);
+		if (ns < 10ull * NSEC_PER_SEC) {
+			return EBUSY;           /* a command may still be in flight */
+		}
+	}
+	base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	bounce = (void *)(su.dma + DMA_BOUNCE);
+	total = os_atomic_load(&sweet_log_total, relaxed);
+	pos = total > SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : 0;
+	while (pos < total) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) /
+		    UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		if (error) {
+			break;
+		}
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = 0xffffffffu,
+		};
+
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+		if (!error) {
+			error = ufs_sync_cache();
+		}
+	}
+	su.emergency_dumps++;
+	su.emergency_error = error;
+	return error;
+}
+
 static void
 sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
