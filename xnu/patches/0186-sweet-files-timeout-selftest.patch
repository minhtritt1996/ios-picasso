 static void
+sf_timeout_test(void *arg __unused, wait_result_t wr __unused)
+{
+	static int chan;
+	uint64_t t0, dt = 0, d2 = 0;
+	printf("SWEET TIMEOUT TEST: start, hz %d, asking for %d ticks (1 s)\n", hz, hz);
+	t0 = mach_absolute_time();
+	(void)tsleep(&chan, PZERO, "sfprobe", hz);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &dt);
+	printf("SWEET TIMEOUT TEST: tsleep woke after %llu ms\n", (unsigned long long)(dt / 1000000ull));
+	t0 = mach_absolute_time();
+	(void)tsleep(&chan, PZERO, "sfprobe2", 10 * hz);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &d2);
+	printf("SWEET TIMEOUT TEST: tsleep 10 s woke after %llu ms\n", (unsigned long long)(d2 / 1000000ull));
+}
