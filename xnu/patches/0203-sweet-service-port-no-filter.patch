--- a/osfmk/ipc/mach_port.c
+++ b/osfmk/ipc/mach_port.c
@@ -3067,9 +3067,24 @@
 		return KERN_INVALID_ARGUMENT;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * This port has no Sandbox kext, so no message-filter callbacks are ever
+	 * registered and mach_msg_filter_at_least() is false. The stock early
+	 * return of KERN_NOT_SUPPORTED makes libxpc's check-in verification fail:
+	 * it accepts only KERN_SUCCESS or KERN_INVALID_CAPABILITY and drops the
+	 * peer otherwise ("Bogus check-in attempt"), which is why every XPC job
+	 * stalled at "service state: xpcproxy" and no daemon ever checked in.
+	 * Fall through instead: with no service-port sblabel the function returns
+	 * KERN_SUCCESS with filter id 0, and non-service ports still get
+	 * KERN_INVALID_CAPABILITY. Same fix as bergamota's
+	 * 0156-ios18-service-port-no-filter.patch.
+	 */
+#else
 	if (!mach_msg_filter_at_least(MACH_MSG_FILTER_CALLBACKS_VERSION_1)) {
 		return KERN_NOT_SUPPORTED;
 	}
+#endif
 
 	ret = ipc_port_translate_receive(space, service_port_name, &service_port);
 	if (ret) {
