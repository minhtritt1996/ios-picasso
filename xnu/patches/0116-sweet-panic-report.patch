--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1462,6 +1462,58 @@
  * is what a panic there would look like.  Writes the ring on every panic
  * chunk (the partition then holds the panic message and backtrace).
  */
+/*
+ * Called from consdebug_putc (): that is the path _doprnt uses to print the
+ * panic report, and it runs whether or not the console is muted.  The flush is
+ * rate limited: writing the ring takes a few hundred ms and the panic path must
+ * not spend that per character.
+ */
+int sweet_ufs_panic_dump(void);     /* defined below, used by both entries */
+
+void
+sweet_panic_putc(char c)
+{
+	extern const char *debugger_panic_str;  /* osfmk/kern/debug.c */
+	static uint64_t last_dump;
+
+	if (debugger_panic_str == NULL) {
+		return;
+	}
+	sweet_log_append(&c, 1);
+	if (c == '\n') {
+		uint64_t now = mach_absolute_time(), ns = 0;
+		if (last_dump != 0) {
+			absolutetime_to_nanoseconds(now - last_dump, &ns);
+		}
+		if (last_dump == 0 || ns > 200ull * NSEC_PER_MSEC) {
+			last_dump = now;
+			(void)sweet_ufs_panic_dump();
+		}
+	}
+}
+
+/*
+ * Called from panic_spin_forever (): the formatted reason still exists there,
+ * and its console print is gated on PE_i_can_has_debugger ()/panicDebugging
+ * while the paniclog has no region on this port, so this is the only
+ * unconditional place to put the reason into the ring.
+ */
+void
+sweet_panic_report(const char *s)
+{
+	char line[256];
+	int n;
+
+	if (s == NULL || s[0] == '\0') {
+		return;
+	}
+	n = snprintf(line, sizeof(line), "\nSWEET PANIC: %s\n", s);
+	if (n > 0) {
+		sweet_log_append(line, MIN(n, (int)sizeof(line) - 1));
+	}
+	(void)sweet_ufs_panic_dump();
+}
+
 void
 sweet_ufs_panic_dump(void)
 {
