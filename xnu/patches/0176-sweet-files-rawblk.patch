+/*
+ * Write count blocks of `src` to lba through the bounce buffer. Used by the
+ * files server's RAWBLK command: the VFS path wedges on this port, and the
+ * boot-time ring flusher already writes this way.
+ */
+int
+sweet_ufs_write_blocks_raw(uint64_t lba, uint32_t count, const void *src)
+{
+	int error;
+
+	if (count == 0 || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	/* lba is partition-relative (image block numbers); the driver wants the
+	 * absolute LUN block. */
+	lba += su.first_block;
+	/*
+	 * Own lock, not sweet_ufs_lock: the flusher can hold that one while it talks
+	 * to the engine, and waiting on it wedged the files server. Serialise RAWBLK
+	 * against itself only.
+	 */
+	if (!lck_mtx_try_lock(&sweet_raw_lock)) {
+		return EBUSY;
+	}
+	memcpy((void *)(su.dma + DMA_BOUNCE), src, (size_t)count * UFS_BLOCK);
+	error = ufs_write_blocks(lba, count);
+	lck_mtx_unlock(&sweet_raw_lock);
+	return error;
+}
