+/* RAWBLK <start_block> <nblocks>: write nblocks*4096 bytes straight to the root
+ * device. Nothing in the catalog changes, so this is the safe way to replace a
+ * file of the SAME size without a recovery round trip (the VFS create path
+ * wedges on this port). */
 static int
+sf_rawblk(socket_t so, uint64_t blk, uint64_t cnt)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	uint64_t off = blk * 4096ULL, left = cnt * 4096ULL;
+	int err = vnode_open("/dev/rufsroot0", FREAD | FWRITE, 0, 0, &vp, ctx);
+
+	if (err != 0) {
+		return err;
+	}
+	while (left != 0) {
+		size_t chunk = (size_t)MIN((uint64_t)SF_BUF, left);
+		int resid = 0;
+
+		if ((err = sf_recv_all(so, sf_buf, chunk)) != 0) {
+			break;
+		}
+		err = vn_rdwr(UIO_WRITE, vp, sf_buf, (int)chunk, (off_t)off, UIO_SYSSPACE,
+		    IO_UNIT | IO_SYNC, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (err != 0 || resid != 0) {
+			if (err == 0) {
+				err = EIO;
+			}
+			break;
+		}
+		off += chunk;
+		left -= chunk;
+	}
+	vnode_put(vp);
+	return err;
+}
