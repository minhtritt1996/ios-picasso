--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1419,6 +1419,54 @@
 /* Called for all console output, any context: never blocks. */
 void sweet_log_append(const char *c, int size);
 
+/*
+ * Early-boot ring write. sweet_log_append() only buffers in RAM and the flusher
+ * thread starts much later, so a boot that dies before that leaves no ring at all
+ * (measured: the ring kept an older boot's content across several boots, which made
+ * every recent failure invisible). While the thread has not started, append() writes
+ * the last 8 KiB of the ring plus the header straight to the device.
+ */
+static uint32_t sweet_log_early_tick;
+
+static void
+sweet_log_early_flush(void)
+{
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	uint64_t base, total, pos;
+	uint32_t off, blk, n;
+
+	if (sweet_log_started_g || !su.ready || !su.writable || su.nblocks == 0 ||
+	    ml_at_interrupt_context() || !ml_get_interrupts_enabled() ||
+	    get_preemption_level() != 0) {
+		return;
+	}
+	/* at most every 64 appends: enough to cover early boot, cheap enough to keep */
+	if (++sweet_log_early_tick % 64 != 0) {
+		return;
+	}
+	base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	total = os_atomic_load(&sweet_log_total, relaxed);
+	pos = total > SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : 0;
+	off = (uint32_t)(pos % SWEET_LOG_SIZE);
+	blk = off / UFS_BLOCK;
+	n = 2;
+	if (blk + n > SWEET_LOG_SIZE / UFS_BLOCK) {
+		n = (uint32_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk);
+	}
+	ufs_lock(UFS_LK_FLUSH);
+	memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+	if (ufs_write_blocks(base + 1 + blk, n) == 0) {
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total,
+			.seq = 0xffffffffu,
+		};
+		memcpy(bounce, &h, sizeof(h));
+		(void)ufs_write_blocks(base, 1);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
+
 void
 sweet_log_append(const char *c, int size)
 {
@@ -1429,6 +1477,7 @@
 	for (int i = 0; i < size; i++) {
 		sweet_log_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = c[i];
 	}
+	sweet_log_early_flush();
 }
 
