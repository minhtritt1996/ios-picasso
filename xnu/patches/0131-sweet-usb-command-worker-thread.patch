 /*
+ * Command worker: every control frame the event thread receives is executed
+ * here, so a blocking command (VFS, console lock) can never freeze the USB
+ * event thread. Replies are queued on the normal TX path.
+ */
+static void
+ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char cmd[1200];
+	uint8_t dst[ETHER_ADDR_LEN];
+
+	for (;;) {
+		lck_mtx_lock(ud.lock);
+		if (!ud.cmd_pending) {
+			assert_wait(&ud.cmd_pending, THREAD_UNINT);
+			lck_mtx_unlock(ud.lock);
+			thread_block(THREAD_CONTINUE_NULL);
+			continue;
+		}
+		memcpy(cmd, ud.cmd_buf, sizeof(cmd));
+		memcpy(dst, ud.cmd_dst, ETHER_ADDR_LEN);
+		ud.cmd_pending = false;
+		lck_mtx_unlock(ud.lock);
+
+		ud_cmd_exec(cmd, dst);
+		if (strcmp(cmd, "reboot") == 0) {
+			ud_sleep_ms(300);
+			printf("SWEET USB: reboot requested over the control channel\n");
+			reboot_kernel(RB_AUTOBOOT, NULL);
+		}
+	}
+}
