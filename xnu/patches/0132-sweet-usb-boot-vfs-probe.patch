 /*
+ * VFS probe: the same lookups the control channel offers, but on a thread that
+ * starts once at boot. If these hang, VFS from a kernel thread is unusable on
+ * this port (a stat over the channel froze the whole link) - and the missing
+ * result line is the proof. sweetvfsprobe=0 disables it.
+ */
+static void
+ud_vfs_probe_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static const char *paths[] = {
+		"/bin/sh",
+		"/usr/libexec/sshd",
+		"/usr/sbin/sshd",
+		"/System/Library/xpc/launchd.plist",
+		"/sbin/launchd",
+	};
+	char out[300];
+	int probe = 1;
+
+	ud_sleep_ms(8000);
+	PE_parse_boot_argn("sweetvfsprobe", &probe, sizeof(probe));
+	if (!probe) {
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(paths) / sizeof(paths[0]); i++) {
+		printf("SWEET USB: vfs probe start %s\n", paths[i]);
+		out[0] = 0;
+		ud_stat(paths[i], out, sizeof(out));
+		printf("SWEET USB: vfs probe %s", out);
+	}
+	printf("SWEET USB: vfs probe done\n");
+}
