diff --git a/osfmk/arm64/sweet_fb.h b/osfmk/arm64/sweet_fb.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/sweet_fb.h
@@ -0,0 +1,20 @@
+/*
+ * Physical base of the boot splash framebuffer that carries the bootstrap
+ * console: the stage-0 band in start.s, sweet_early.c's text screen and the
+ * Normal-NC alias arm_vm_init.c installs before TTBR0 goes away.
+ *
+ * The address is board specific and was hard-coded to sweet's 0x9c000000.
+ * On picasso (Redmi K30 5G, SM7250) the splash sits at 0xa0000000: that is
+ * what the shim's probe screen reports ("FB 00000000A0000000") and what the
+ * "sweet-fbcon" ADT node carries, so the whole console wrote into ordinary
+ * DRAM nobody could see. Board builds override with -DSWEET_FB_PA=0x...;
+ * the default here is picasso.
+ */
+#ifndef _ARM64_SWEET_FB_H_
+#define _ARM64_SWEET_FB_H_
+
+#ifndef SWEET_FB_PA
+#define SWEET_FB_PA 0xa0000000
+#endif
+
+#endif /* _ARM64_SWEET_FB_H_ */
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -27,6 +27,7 @@
  */
 #include <arm64/proc_reg.h>
 #include <arm64/asm.h>
+#include <arm64/sweet_fb.h>
 #include <arm64/machine_machdep.h>
 #include <arm64/proc_reg.h>
 #include <pexpert/arm64/board_config.h>
@@ -515,7 +516,7 @@
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (SWEET_FB_PA + 2368 * 4320)
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4320
@@ -686,7 +687,7 @@
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, SWEET_FB_PA
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -42,6 +42,7 @@
 #include <arm64/proc_reg.h>
 #include <arm64/lowglobals.h>
 #include <arm64/sweet_early.h>
+#include <arm64/sweet_fb.h>
 #include <arm/cpu_data_internal.h>
 #include <arm/misc_protos.h>
 #include <pexpert/arm64/boot.h>
@@ -1843,7 +1844,7 @@
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = (tt_entry_t)SWEET_FB_PA | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -6,12 +6,13 @@
  * retain this console until the normal framebuffer serial console is ready.
  */
 #include <arm64/sweet_early.h>
+#include <arm64/sweet_fb.h>
 
 #if defined(SWEET)
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)SWEET_FB_PA;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
 #define EARLY_HEIGHT 2400u
