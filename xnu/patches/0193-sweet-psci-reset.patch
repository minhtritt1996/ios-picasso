+	/*
+	 * PSCI SYSTEM_RESET, not PS_HOLD: releasing PS_HOLD cuts the PMIC power, which
+	 * wipes the IMEM word we just wrote, so ABL boots normally. A warm reset keeps
+	 * IMEM and lets ABL act on the reason.
+	 */
 	{
+		register uint64_t px0 __asm__("x0") = 0x84000009ULL;
+
+		__asm__ volatile("smc #0" : "+r"(px0) : : "x1", "x2", "x3", "x4", "x5",
+		    "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+		    "x16", "x17", "cc", "memory");
+	}
+	/* If PSCI did not take, fall back to PS_HOLD (power off) so the command
+	 * still does something visible. */
+	{
 		vm_offset_t psh = ml_io_map(SWEET_PSHOLD_PA, 0x1000);
 
 		if (psh != 0) {
-			*(volatile uint32_t *)psh = 0;      /* PS_HOLD low -> reset */
+			*(volatile uint32_t *)psh = 0;
 		}
 	}
 	for (volatile int i = 0; i < 200000000; i++) {
-		/* if PS_HOLD did not take effect, keep the CPU busy until the watchdog */
+		/* keep the CPU busy until the watchdog if neither took effect */
 	}
 }
 
