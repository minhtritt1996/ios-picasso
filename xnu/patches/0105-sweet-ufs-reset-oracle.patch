--- a/iokit/Kernel/arm/PicassoModem.cpp
+++ b/iokit/Kernel/arm/PicassoModem.cpp
@@ -3754,6 +3754,33 @@
 	LOG("recovery: PSCI reset returned");
 }
 
+/* Independent of the modem/GLINK path: after sweetresetms ms, dump the log ring
+ * without the driver lock and reset through PSCI only.  No partition lookup,
+ * no BCB write, so a stuck driver lock cannot keep the reset from happening:
+ * whether the phone comes back to fastboot says whether the machine was still
+ * running (a frozen console alone) or the whole SoC had stopped. */
+static void
+reset_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t ms = 0;
+	uint64_t a[8] = { 0x84000009ULL, 0, 0, 0, 0, 0, 0, 0 };
+
+	if (!PE_parse_boot_argn("sweetresetms", &ms, sizeof(ms)) || ms < 1000) {
+		thread_terminate(current_thread());
+		return;
+	}
+	IOSleep(ms);
+	{
+		int d = sweet_ufs_emergency_dump();
+		LOG("reset: ring dump (no lock) %d", d);
+	}
+	IOSleep(200);
+	LOG("reset: PSCI SYSTEM_RESET");
+	smc_call(a);
+	LOG("reset: PSCI reset returned");
+	thread_terminate(current_thread());
+}
+
 /* Independent of the modem/GLINK path: after modem_recovery_after ms, write the
  * Android BCB command "boot-recovery" into misc and reset through PSCI, so a
  * hung modem thread can never keep the phone in iOS. */
@@ -3969,6 +3996,12 @@
 			thread_deallocate(mon);
 		}
 	}
+	{
+		thread_t t = THREAD_NULL;
+		if (kernel_thread_start(reset_thread, NULL, &t) == KERN_SUCCESS) {
+			thread_deallocate(t);
+		}
+	}
 	if (kernel_thread_start(recovery_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
